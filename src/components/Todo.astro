---
// Zichtbare plek voor inhoud die nog van het bouwbedrijf moet komen.
// Alleen zichtbaar zolang niet alles is aangeleverd (launchReady = false), en dan
// alleen in `npm run dev` of als de site niet indexeerbaar is: bezoekers en Google
// zien deze blokken niet.
import { site } from '../data/site';
interface Props { label: string; }
---
{!site.launchReady && (import.meta.env.DEV || !site.indexable) && <div class="todo" role="note"><strong>Nog aanleveren:</strong> {Astro.props.label}</div>}
