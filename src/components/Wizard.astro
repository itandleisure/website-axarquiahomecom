const T = ALL[lang];
const NL = ALL.nl;
const C = contactTeksten[lang];
const groepen = Object.entries(vragen) as [Dienst, (typeof vragen)[Dienst]][];
// Per dienst: titel van stap 4, voorbeeldtekst in stap 5 en welke algemene vragen erbij horen
const perDienst = Object.fromEntries(groepen.map(([k, g]) => [k, {
  legend: g.legend[lang],
  ph: g.placeholder[lang],
  situatie: g.situatie !== false,
  fotos: g.fotos !== false,
}]));
---
      <p class="wizard-alt">{C.fromWizard} <a href={path(lang, 'contact')}>{C.fromWizardLink}</a>.</p>
      <form id="keuzehulp" class="wizard" data-endpoint={endpoint} data-thanks={path(lang, 'thanks')} data-msgs={JSON.stringify(T.msgs)} data-diensten={JSON.stringify(perDienst)} data-pakket={JSON.stringify(pakketAlias)} novalidate>
        <div class="step-count" aria-live="polite">{T.step} <span data-current>1</span> {T.of} <span data-total>6</span></div>
        <div class="progress" aria-hidden="true"><span></span></div>

        <fieldset class="wstep" data-step="1">
          <legend>{T.q1}</legend>
          <div class="choices">
            {T.diensten.map((d) => (
              <label class="choice"><input type="radio" name="dienst" value={d.v} required /><span>{d.t}<small>{d.s}</small></span></label>
            ))}
          </div>
        </fieldset>

        <fieldset class="wstep" data-step="2" hidden>
          <legend data-legend2 data-alt={T.typeLabel}>{T.q2}</legend>
          <div class="choices" data-situatie>
            {T.situaties.map((d) => (
              <label class="choice"><input type="radio" name="situatie" value={d.v} required /><span>{d.t}{d.s && <small>{d.s}</small>}</span></label>
            ))}
          </div>
          <div class="field" style="margin-top:20px">
            <label for="type" data-type-label>{T.typeLabel}</label>
            <select id="type" name="type_woning" aria-label={T.typeLabel}>
              <option value="">{T.typeChoose}</option>
              {T.typen.map((t, i) => <option value={NL.typen[i]}>{t}</option>)}
            </select>
          </div>
        </fieldset>

        <fieldset class="wstep" data-step="3" hidden>
          <legend>{T.q3}</legend>
          <div class="field">
            <label for="plaats">{T.plaats}</label>
            <select id="plaats" name="plaats" required>
              <option value="">{T.plaatsChoose}</option>
              {[...places].sort((a, b) => a.name.localeCompare(b.name, 'es')).map((p) => <option data-slug={p.slug}>{p.name}</option>)}
              {T.plaatsExtra.map((p, i) => <option value={NL.plaatsExtra[i]}>{p}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="adres">{T.adres} <span class="note">{T.optional}</span></label>
            <input id="adres" name="adres" type="text" autocomplete="street-address" placeholder={T.adresPh} />
          </div>
        </fieldset>

        <fieldset class="wstep" data-step="4" hidden>
          <legend data-legend4>{T.q1}</legend>
          {groepen.map(([key, g]) => (
            <div data-groep={key} hidden>
              {g.vragen.map((v) => {
                const id = `${key}-${v.name}`;
                return (
                  <div class="field" data-q={v.name} data-nl={v.label.nl} data-kind={v.kind} data-required={v.required ? '1' : undefined} data-show-if={v.showIf ? JSON.stringify(v.showIf) : undefined}>
                    {v.kind === 'select' ? (
                      <>
                        <label for={id}>{v.label[lang]}</label>
                        <select id={id} name={v.name} required={v.required} disabled>
                          <option value="">{T.kies}</option>
                          {v.options.map((o) => <option value={o.t.nl}>{o.t[lang]}</option>)}
                        </select>
                      </>
                    ) : (
                      <>
                        <p class="qlabel" id={id}>{v.label[lang]}</p>
                        <div class="choices" role={v.kind === 'radio' ? 'radiogroup' : 'group'} aria-labelledby={id}>
                          {v.options.map((o) => (
                            <label class="choice"><input type={v.kind === 'radio' ? 'radio' : 'checkbox'} name={v.name} value={o.t.nl} disabled /><span>{o.t[lang]}{o.s && <small>{o.s[lang]}</small>}</span></label>
                          ))}
                        </div>
                      </>
                    )}
                    {v.hint && <p class="hint">{v.hint[lang]}</p>}
                  </div>
                );
              })}
            </div>
          ))}
        </fieldset>

        <fieldset class="wstep" data-step="5" hidden>
          <legend>{T.q5}</legend>
          <div class="field">
            <label for="omschrijving">{T.omschrijving} <span class="note">{T.optional}</span></label>
            <textarea id="omschrijving" name="omschrijving" rows="5"></textarea>
          </div>
          <div class="field" data-foto>
            <label for="fotos">{T.fotos} <span class="note">{T.fotosOpt}</span></label>
            <input id="fotos" type="file" accept="image/*" multiple />
            <p class="hint">{T.fotosHint}</p>
            <div class="thumbs" data-thumbs></div>
          </div>
        </fieldset>

        <fieldset class="wstep" data-step="6" hidden>
          <legend>{T.q6}</legend>
          <div class="row2">
            <div class="field"><label for="naam">{T.naam}</label><input id="naam" name="naam" type="text" autocomplete="name" required /></div>
            <div class="field"><label for="email">{T.email}</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
            <div class="field"><label for="telefoon">{T.telefoon}</label><input id="telefoon" name="telefoon" type="tel" autocomplete="tel" placeholder={T.telPh} required /></div>
            <div class="field">
              <label for="contact">{T.contact}</label>
              <select id="contact" name="contactvoorkeur">
                {T.contactOpts.map((o, i) => <option value={NL.contactOpts[i]}>{o}</option>)}
              </select>
            </div>
          </div>
          <div class="hp" aria-hidden="true"><label>{T.hp} <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
          <label class="consent"><input type="checkbox" name="toestemming" value="ja" required /><span>{T.consent} <a href={path(lang, 'privacy')} target="_blank">{T.privacy}</a>.</span></label>
          <label class="consent"><input type="checkbox" name="toestemming_partner" value="ja" /><span>{T.consentPartner} <span class="note">{T.optional}</span></span></label>
        </fieldset>

        <p class="wizard-error" role="alert" data-error></p>
        <div class="wizard-nav">
          <button type="button" class="btn btn-ghost" data-prev hidden>{T.prev}</button>
          <button type="button" class="btn" data-next style="margin-left:auto">{T.next}</button>
          <button type="submit" class="btn" data-submit hidden style="margin-left:auto">{T.submit}</button>
        </div>
      </form>

<style>
  .wizard-alt { margin: -12px 0 20px; color: var(--muted); }
  .qlabel { font-weight: 600; margin: 0 0 8px; }
  [data-groep] .field + .field { margin-top: 22px; }
</style>

<script>
  import { sendLead, newId } from '../scripts/send-lead';

  type DienstInfo = { legend: string; ph: string; situatie: boolean; fotos: boolean };
  const form = document.getElementById('keuzehulp') as HTMLFormElement;
  const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>('.wstep'));
  const prev = form.querySelector<HTMLButtonElement>('[data-prev]')!;
  const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const errorEl = form.querySelector<HTMLElement>('[data-error]')!;
  const bar = form.querySelector<HTMLElement>('.progress span')!;
  const cur = form.querySelector<HTMLElement>('[data-current]')!;
  const fotoInput = form.querySelector<HTMLInputElement>('#fotos')!;
  const fotoField = form.querySelector<HTMLElement>('[data-foto]')!;
  const thumbs = form.querySelector<HTMLElement>('[data-thumbs]')!;
  const omschrijving = form.querySelector<HTMLTextAreaElement>('#omschrijving')!;
  const legend2 = form.querySelector<HTMLElement>('[data-legend2]')!;
  const legend2Text = legend2.textContent ?? '';
  const typeLabel = form.querySelector<HTMLElement>('[data-type-label]')!;
  const situatieBox = form.querySelector<HTMLElement>('[data-situatie]')!;
  const legend4 = form.querySelector<HTMLElement>('[data-legend4]')!;
  const groepen = Array.from(form.querySelectorAll<HTMLElement>('[data-groep]'));
  const M = JSON.parse(form.dataset.msgs || '{}');
  const D: Record<string, DienstInfo> = JSON.parse(form.dataset.diensten || '{}');
  const pakketAlias: Record<string, string> = JSON.parse(form.dataset.pakket || '{}');
  let index = 0;
  let photos: { name: string; type: string; data: string }[] = [];

  const dienst = () => (form.elements.namedItem('dienst') as RadioNodeList).value;
  /** Staat dit veld in een deel dat voor deze dienst niet van toepassing is? */
  const off = (el: Element) => !!el.closest('[data-groep][hidden], [data-show-if][hidden], [data-situatie][hidden], [data-foto][hidden]');

  // Velden die niet van toepassing zijn uitschakelen: ze worden dan niet gecontroleerd en niet verstuurd
  function syncDisabled() {
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-groep] input, [data-groep] select, [data-situatie] input')
      .forEach((f) => (f.disabled = off(f)));
  }

  function applyShowIf() {
    form.querySelectorAll<HTMLElement>('[data-show-if]').forEach((el) => {
      const c = JSON.parse(el.dataset.showIf!) as { name: string; values: string[] };
      const v = el.closest('[data-groep]')?.querySelector<HTMLInputElement>(`input[name="${c.name}"]:checked`)?.value;
      el.hidden = !v || !c.values.includes(v);
    });
  }

  function applyDienst() {
    const d = dienst();
    const info = D[d] ?? { legend: '', ph: '', situatie: true, fotos: true };
    groepen.forEach((g) => (g.hidden = g.dataset.groep !== d));
    legend4.textContent = info.legend;
    omschrijving.placeholder = info.ph;
    situatieBox.hidden = !info.situatie;
    legend2.textContent = info.situatie ? legend2Text : (legend2.dataset.alt ?? legend2Text);
    typeLabel.hidden = !info.situatie;
    fotoField.hidden = !info.fotos;
    applyShowIf();
    syncDisabled();
  }

  // Voorkeuze via ?dienst=…&plaats=…&pakket=…
  const params = new URLSearchParams(location.search);
  const pre = params.get('dienst');
  if (pre) {
    const r = form.querySelector<HTMLInputElement>(`input[name="dienst"][value="${CSS.escape(pre)}"]`);
    if (r) r.checked = true;
  }
  const plaats = params.get('plaats');
  if (plaats) {
    const o = form.querySelector<HTMLOptionElement>(`#plaats option[data-slug="${CSS.escape(plaats)}"]`);
    if (o) o.selected = true;
  }
  const pakket = pakketAlias[(params.get('pakket') ?? '').toLowerCase()];
  if (pakket) {
    const r = form.querySelector<HTMLInputElement>(`[data-groep="sleutelbeheer"] input[name="pakket"][value="${CSS.escape(pakket)}"]`);
    if (r) r.checked = true;
  }
  // Budget vanaf de rekentool (?budget=0…4, de volgorde van de budgetkeuzes), bij de budgetvraag van de gekozen dienst
  const budgetParam = params.get('budget');
  if (budgetParam && /^\d$/.test(budgetParam)) {
    const sel = form.querySelector<HTMLSelectElement>(`[data-groep="${CSS.escape(dienst())}"] select[name="budget"]`);
    const i = Number(budgetParam) + 1;
    if (sel && i < sel.options.length - 1) sel.selectedIndex = i;
  }
  // Vrije tekst vanaf een kosten- of probleempagina (?onderwerp=…), alleen als het veld nog leeg is
  const onderwerp = params.get('onderwerp');
  if (onderwerp) {
    const t = form.querySelector<HTMLTextAreaElement>('#omschrijving')!;
    if (!t.value) t.value = onderwerp.slice(0, 500);
  }
  applyDienst();

  function show(i: number) {
    index = i;
    steps.forEach((s, n) => (s.hidden = n !== i));
    prev.hidden = i === 0;
    next.hidden = i === steps.length - 1;
    submit.hidden = i !== steps.length - 1;
    bar.style.width = `${((i + 1) / steps.length) * 100}%`;
    cur.textContent = String(i + 1);
    errorEl.textContent = '';
  }

  function valid(i: number): boolean {
    const step = steps[i];
    const fields = Array.from(step.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]'));
    for (const f of fields) {
      if (f.disabled || off(f)) continue;
      if (f instanceof HTMLInputElement && f.type === 'radio') {
        if (!(form.elements.namedItem(f.name) as RadioNodeList).value) {
          errorEl.textContent = M.choose;
          return false;
        }
      } else if (f instanceof HTMLInputElement && f.type === 'checkbox') {
        if (!f.checked) { errorEl.textContent = M.consent; return false; }
      } else if (f instanceof HTMLSelectElement && f.closest('[data-q]') && !f.value) {
        errorEl.textContent = M.choose;
        f.focus();
        return false;
      } else if (!f.value.trim() || !f.checkValidity()) {
        const label = form.querySelector(`label[for="${f.id}"]`)?.textContent?.trim() ?? M.thisField;
        errorEl.textContent = M.fill.replace('{x}', M.keepCase ? label : label.toLowerCase());
        f.focus();
        return false;
      }
    }
    // Keuzevragen (rondjes en vinkjes) in stap 4: minstens één antwoord
    for (const q of Array.from(step.querySelectorAll<HTMLElement>('[data-q][data-required]'))) {
      if (off(q) || q.dataset.kind === 'select') continue;
      if (!q.querySelector('input:checked')) {
        errorEl.textContent = M.choose;
        q.querySelector<HTMLInputElement>('input')?.focus();
        return false;
      }
    }
    return true;
  }

  next.addEventListener('click', () => { if (valid(index)) show(index + 1); });
  prev.addEventListener('click', () => show(index - 1));
  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'dienst') applyDienst();
    else if (t.closest('[data-groep]')) { applyShowIf(); syncDisabled(); }
    if (t.type === 'radio' && index < 2) setTimeout(() => valid(index) && show(index + 1), 180);
  });

  // Foto's verkleinen in de browser (max. 1600 px) zodat het versturen snel gaat
  async function resize(file: File): Promise<{ name: string; type: string; data: string }> {
    const img = await createImageBitmap(file);
    const scale = Math.min(1, 1600 / Math.max(img.width, img.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(img.width * scale);
    canvas.height = Math.round(img.height * scale);
    canvas.getContext('2d')!.drawImage(img, 0, 0, canvas.width, canvas.height);
    const dataUrl = canvas.toDataURL('image/jpeg', 0.8);
    return { name: file.name.replace(/\.[^.]+$/, '') + '.jpg', type: 'image/jpeg', data: dataUrl.split(',')[1] };
  }
  fotoInput.addEventListener('change', async () => {
    const files = Array.from(fotoInput.files ?? []).slice(0, 5);
    thumbs.innerHTML = '';
    photos = [];
    for (const f of files) {
      try {
        const p = await resize(f);
        photos.push(p);
        const im = document.createElement('img');
        im.src = `data:image/jpeg;base64,${p.data}`;
        im.alt = f.name;
        thumbs.appendChild(im);
      } catch { /* bestand overslaan als het geen bruikbare foto is */ }
    }
  });

  /** Antwoorden op de dienstvragen als leesbare regels voor het bouwbedrijf (altijd in het Nederlands). */
  function details(fd: FormData): string[] {
    const groep = groepen.find((g) => !g.hidden);
    if (!groep) return [];
    const regels: string[] = [];
    groep.querySelectorAll<HTMLElement>('[data-q]').forEach((q) => {
      const name = q.dataset.q!;
      if (off(q) || name === 'planning' || name === 'budget') return;
      const vals = fd.getAll(name).map(String).filter(Boolean);
      if (vals.length) regels.push(`${q.dataset.nl}: ${vals.join(', ')}`);
    });
    return regels;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!valid(index)) return;
    const endpoint = form.dataset.endpoint;
    const fd = new FormData(form);
    if (fd.get('website')) return; // spam
    const regels = details(fd);
    const data: Record<string, unknown> = {};
    const skip = new Set(['website', ...Array.from(groepen.flatMap((g) => Array.from(g.querySelectorAll<HTMLElement>('[data-q]'))))
      .map((q) => q.dataset.q!).filter((n) => n !== 'planning' && n !== 'budget')]);
    for (const [k, v] of fd.entries()) if (!skip.has(k) && typeof v === 'string') data[k] = v;
    if (dienst() === 'aankoopkeuring' && !data.situatie) data.situatie = 'koper';
    // De dienstvragen komen bovenaan de omschrijving, zodat ze in de sheet en de mail staan
    const toelichting = String(data.omschrijving ?? '').trim();
    data.omschrijving = [regels.join('\n'), toelichting && `Toelichting klant:\n${toelichting}`].filter(Boolean).join('\n\n');
    data.taal = document.documentElement.lang;
    data.pagina = document.referrer || location.href;
    data.utm = location.search;
    data.fotos = fotoField.hidden ? [] : photos;
    // Uniek id: het script negeert een tweede inzending met hetzelfde id
    data.id = newId();

    if (!endpoint) {
      errorEl.textContent = M.notLinked;
      console.info('Aanvraag (niet verstuurd):', data);
      return;
    }
    submit.disabled = true;
    const label = submit.textContent;
    submit.textContent = M.sending;
    if (await sendLead(endpoint, data)) {
      location.href = form.dataset.thanks!;
    } else {
      submit.disabled = false;
      submit.textContent = label;
      errorEl.textContent = M.failed;
    }
  });

  show(0);
</script>
