---
// Eén plaats: overzicht, Zien en doen of Wonen. Teksten komen uit src/data/place-content/.
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Hero from './Hero.astro';
import Faq from './Faq.astro';
import Cta from './Cta.astro';
import Todo from './Todo.astro';
import { places, placeBySlug, placeHref, type Place, type PlacePage } from '../data/places';
import { placeContent } from '../data/place-content';
import { services, path as route, type Lang } from '../i18n';
import { site } from '../data/site';
import { guidesBy, guideHref, guideAt } from '../data/guides';
import { placeTabs } from '../data/place-tabs';
import { fiestaHref, fiestaSlugFor } from '../data/fiestas';

interface Props { lang: Lang; place: Place; page: PlacePage; }
const { lang, place, page } = Astro.props;
const c = placeContent[place.slug][lang]!;
const parent = place.municipality ? placeBySlug(place.municipality) : undefined;
const T = {
  nl: {
    places: 'Plaatsen', overview: 'Overzicht', see: 'Zien en doen', living: 'Wonen', facts: 'In het kort',
    forWhom: 'Voor wie past', partOf: 'hoort bij de gemeente', servicesIn: (n: string) => `Wat we in ${n} voor u doen`,
    servicesText: (n: string) => `Een woning in ${n} kopen, verbouwen of laten beheren? Eén Nederlandstalig team regelt het.`,
    ctaTitle: (n: string) => `Plannen voor een huis in ${n}?`, request: 'Aanvraag voor', fiestas: 'Fiesta’s', guides: 'Handig bij kopen en verbouwen',
    nearby: 'In de buurt', tip: (n: string) => `tip van het bouwbedrijf over bouwen en verbouwen in ${n} (één of twee zinnen) en een eigen foto.`,
    seeIn: (n: string) => `Zien en doen in ${n}`, livingIn: (n: string) => `Wonen in ${n}`,
  },
  en: {
    places: 'Places', overview: 'Overview', see: 'Things to do', living: 'Living', facts: 'At a glance',
    forWhom: 'Who it suits', partOf: 'part of the municipality of', servicesIn: (n: string) => `What we do for you in ${n}`,
    servicesText: (n: string) => `Buying, renovating or looking after a home in ${n}? One English-speaking team takes care of it.`,
    ctaTitle: (n: string) => `Plans for a home in ${n}?`, request: 'Request for', fiestas: 'Fiestas', guides: 'Useful when buying and renovating',
    nearby: 'Nearby', tip: (n: string) => `tip van het bouwbedrijf over bouwen en verbouwen in ${n} (Engels) en een eigen foto.`,
    seeIn: (n: string) => `Things to do in ${n}`, livingIn: (n: string) => `Living in ${n}`,
  },
  de: {
    places: 'Orte', overview: 'Überblick', see: 'Sehenswertes', living: 'Wohnen', facts: 'Auf einen Blick',
    forWhom: 'Für wen es passt', partOf: 'gehört zur Gemeinde', servicesIn: (n: string) => `Was wir in ${n} für Sie tun`,
    servicesText: (n: string) => `Ein Haus in ${n} kaufen, renovieren oder betreuen lassen? Ein Team kümmert sich darum, mit Kontakt auf Englisch oder Niederländisch.`,
    ctaTitle: (n: string) => `Pläne für ein Haus in ${n}?`, request: 'Anfrage für', fiestas: 'Feste', guides: 'Nützlich bei Kauf und Renovierung',
    nearby: 'In der Nähe', tip: (n: string) => `tip van het bouwbedrijf over bouwen en verbouwen in ${n} (Duits) en een eigen foto.`,
    seeIn: (n: string) => `Sehenswertes in ${n}`, livingIn: (n: string) => `Wohnen in ${n}`,
  },
  sv: {
    places: 'Orter', overview: 'Översikt', see: 'Se och göra', living: 'Bo', facts: 'I korthet',
    forWhom: 'Passar för', partOf: 'hör till kommunen', servicesIn: (n: string) => `Det här gör vi för dig i ${n}`,
    servicesText: (n: string) => `Köpa, renovera eller låta någon sköta ett hus i ${n}? Ett team tar hand om allt, med kontakt på engelska eller nederländska.`,
    ctaTitle: (n: string) => `Planer för ett hus i ${n}?`, request: 'Förfrågan för', fiestas: 'Fiestor', guides: 'Bra att läsa vid köp och renovering',
    nearby: 'I närheten', tip: (n: string) => `tip van het bouwbedrijf over bouwen en verbouwen in ${n} (Engels) en een eigen foto.`,
    seeIn: (n: string) => `Se och göra i ${n}`, livingIn: (n: string) => `Bo i ${n}`,
  },
}[lang];

// Diensten in de volgorde die bij de plaats past
const svcKeys = ['renovatie', 'sleutelbeheer', 'aankoopkeuring', 'zwembad', 'onderhoud'];
const order = place.setting === 'coast' ? [1, 0, 4, 3, 2] : place.setting === 'mountains' || place.setting === 'inland' ? [0, 2, 4, 1, 3] : [0, 1, 2, 3, 4];
const svcs = order.map((i) => ({ ...services[lang][i], key: svcKeys[i] }));
const request = route(lang, 'request');

// Tabs, inclusief Bouwvergunning en Praktisch (bij een kern die van de gemeente)
const tabs = placeTabs(lang, place);
const fiestaSlug = fiestaSlugFor(place.slug, place.municipality);
const fiestaLabel = { nl: 'Feesten', en: 'Fiestas', de: 'Feste', sv: 'Fester' }[lang];
const self = placeHref(lang, place, page);
const sub = page === 'see' ? c.see! : page === 'living' ? c.living! : null;
const title = sub ? sub.title : c.title;
const description = sub ? sub.description : c.description;
const lead = sub ? sub.lead : c.lead;
const h1 = page === 'see' ? T.seeIn(place.name) : page === 'living' ? T.livingIn(place.name) : place.name;
const crumbs = [{ name: T.places, href: route(lang, 'places') }, { name: place.name, href: placeHref(lang, place) }];
if (sub) crumbs.push({ name: page === 'see' ? T.see : T.living, href: self });

// Plaatsen in de buurt: zelfde gemeente of zelfde ligging, alleen gebouwde
const nearby = places
  .filter((p) => p.slug !== place.slug && p.built && placeContent[p.slug]?.[lang])
  .filter((p) => p.municipality === place.slug || place.municipality === p.slug || (p.municipality && p.municipality === place.municipality) || p.setting === place.setting)
  .slice(0, 4);
const buyerGuides = guidesBy[lang].filter((_, i) => [1, 2, 3, 7].includes(i));
// Buiten de kust liggen veel huizen aan een camino: daar ook de gids over de toegangsweg
const roadIndex = guidesBy.nl.findIndex((g) => g.slug === 'toegangsweg-finca-spanje');
const roadGuide = place.setting !== 'coast' && roadIndex >= 0 ? guideAt(lang, roadIndex) : undefined;

const placeLd = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: place.name,
  containedInPlace: { '@type': 'AdministrativeArea', name: parent ? `${parent.name}, Axarquía, Málaga` : 'Axarquía, Málaga' },
  url: new URL(self, site.url).href,
};
---
<Base title={title} description={description} path={self} lang={lang} jsonLd={page === 'overview' ? [placeLd] : []}>
  <Breadcrumbs lang={lang} items={crumbs} />
  <Hero lang={lang} eyebrow={parent ? `${place.name} · ${parent.name}` : 'Axarquía'} title={h1} lead={lead} ctaHref={`${request}?plaats=${place.slug}`}>
    {tabs.length > 1 && (
      <nav class="place-tabs" aria-label={place.name}>
        {tabs.map((t) => (
          <a href={t.href} aria-current={t.page === page ? 'page' : undefined}>{t.label}</a>
        ))}
      </nav>
    )}
  </Hero>

  {page === 'overview' && (
    <section class="section">
      <div class="wrap split">
        <div class="prose">
          {c.intro.map((p) => <p set:html={p} />)}
          {c.forWhom && (<><h2>{T.forWhom} {place.name}?</h2><p set:html={c.forWhom} /></>)}
          {parent && <p class="note">{place.name} {T.partOf} <a href={placeHref(lang, parent)}>{parent.name}</a>.</p>}
        </div>
        <div class="box">
          <h3>{T.facts}</h3>
          <table class="prices"><tbody>
            {c.facts.map(([k, v]) => <tr><td>{k}</td><td set:html={v} /></tr>)}
          </tbody></table>
        </div>
      </div>
    </section>
  )}

  {page === 'see' && c.see && (
    <section class="section">
      <div class="wrap prose">
        <ul class="see-list">
          {c.see.items.map((i) => <li><h2>{i.name}</h2><p set:html={i.text} /></li>)}
        </ul>
        {c.see.fiestas && (
          <>
            <h2>{T.fiestas}</h2>
            <ul>{c.see.fiestas.map((f) => <li><strong>{f.name}</strong> ({f.when}): <span set:html={f.text} /></li>)}</ul>
            {fiestaSlug && <p><a class="more" href={fiestaHref(lang, fiestaSlug)}>{fiestaLabel}: {placeBySlug(fiestaSlug)!.name} →</a></p>}
          </>
        )}
      </div>
    </section>
  )}

  {page === 'living' && c.living && (
    <section class="section">
      <div class="wrap split">
        <div class="prose">
          {c.living.sections.map((s) => (<><h2>{s.h}</h2>{s.p.map((p) => <p set:html={p} />)}</>))}
          <Todo label={T.tip(place.name)} />
        </div>
        <div class="box">
          <h3>{T.guides}</h3>
          <ul class="checks">
            {tabs.filter((t) => t.page === 'permit' || t.page === 'practical').map((t) => <li><a href={t.href}>{t.label}</a></li>)}
            {buyerGuides.map((g) => <li><a href={guideHref(lang, g)}>{g.short}</a></li>)}
            {roadGuide && <li><a href={guideHref(lang, roadGuide)}>{roadGuide.short}</a></li>}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="section alt">
    <div class="wrap">
      <h2>{T.servicesIn(place.name)}</h2>
      <p class="section-intro">{T.servicesText(place.name)}</p>
      <div class="cards">
        {svcs.map((s) => (
          <a class="card" href={s.href}>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {c.faq && c.faq.length > 0 && <Faq items={c.faq} lang={lang} />}

  {nearby.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>{T.nearby}</h2>
        <div class="cards place-cards">
          {nearby.map((p) => <a class="card" href={placeHref(lang, p)}><h3>{p.name}</h3></a>)}
        </div>
      </div>
    </section>
  )}

  <Cta lang={lang} title={T.ctaTitle(place.name)} plaats={place.slug} />
</Base>
