---
import { ui, path, type Lang } from '../i18n';
interface Props { title?: string; text?: string; dienst?: string; plaats?: string; lang?: Lang; }
const { lang = 'nl', dienst, plaats } = Astro.props;
const t = ui[lang];
const title = Astro.props.title ?? t.ctaTitle;
const text = Astro.props.text ?? t.ctaText;
const base = path(lang, 'request');
const q = new URLSearchParams({ ...(dienst ? { dienst } : {}), ...(plaats ? { plaats } : {}) }).toString();
const href = q ? `${base}?${q}` : base;
---
<section class="cta">
  <div class="wrap cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="btn btn-light" href={href}>{t.ctaWizard}</a>
  </div>
</section>
