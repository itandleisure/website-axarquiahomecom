---
import { ui, type Lang } from '../i18n';
interface Props { title?: string; steps: { t: string; d: string }[]; lang?: Lang; }
const { steps, lang = 'nl' } = Astro.props;
const title = Astro.props.title ?? ui[lang].stepsTitle;
---
<section class="section alt">
  <div class="wrap">
    <h2>{title}</h2>
    <ol class="steps">
      {steps.map((s) => (<li><h3>{s.t}</h3><p>{s.d}</p></li>))}
    </ol>
  </div>
</section>
