---
// Overzichtspagina van alle kosten- of probleempagina's in één taal.
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Hero from './Hero.astro';
import Cta from './Cta.astro';
import { site } from '../data/site';
import { calcPath } from '../data/calculator';
import { topics, topicBase, topicUi, topicHref, hubAlternates, type TopicKind, type TopicLang } from '../data/topics';

interface Props {
  kind: TopicKind;
  lang: TopicLang;
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lead: string;
  cta: string;
  /** Extra kaarten, bijv. naar een bestaande gids */
  extra?: { href: string; title: string; text: string }[];
}
const { kind, lang, title, description, eyebrow, heading, lead, cta, extra = [] } = Astro.props;
const u = topicUi[lang];
const path = topicBase[kind][lang];
const list = topics[kind][lang];
const calcCard = kind === 'costs' ? {
  nl: { title: 'Rekentool: bereken uw prijs', text: 'Kies wat u wilt laten doen en zie direct wat het ongeveer kost. Daarna met één klik een offerte.' },
  en: { title: 'Calculator: work out your price', text: 'Choose what you want done and see straight away roughly what it costs. Then ask for a quote in one click.' },
  de: { title: 'Kostenrechner: Preis berechnen', text: 'Wählen Sie, was gemacht werden soll, und sehen Sie sofort die ungefähren Kosten. Danach mit einem Klick ein Angebot.' },
}[lang] : null;
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: list.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.title, url: new URL(topicHref(kind, lang, t), site.url).href })),
};
---
<Base title={title} description={description} path={path} lang={lang} alternates={hubAlternates(kind)} jsonLd={[itemList]}>
  <Breadcrumbs lang={lang} items={[{ name: u.hub[kind], href: path }]} />
  <Hero eyebrow={eyebrow} title={heading} lead={lead} cta={cta} lang={lang} />
  <section class="section">
    <div class="wrap">
      <div class="cards">
        {calcCard && (
          <a class="card" href={calcPath[lang]}>
            <h2 class="h3">{calcCard.title}</h2>
            <p>{calcCard.text}</p>
            <span class="more">{u.read} →</span>
          </a>
        )}
        {list.map((t) => (
          <a class="card" href={topicHref(kind, lang, t)}>
            <h2 class="h3">{t.title}</h2>
            <p>{t.description}</p>
            <span class="more">{u.read} →</span>
          </a>
        ))}
        {extra.map((e) => (
          <a class="card" href={e.href}>
            <h2 class="h3">{e.title}</h2>
            <p>{e.text}</p>
            <span class="more">{u.read} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <slot />
  <Cta lang={lang} />
</Base>
