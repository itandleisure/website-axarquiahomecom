---
import { ui, path, type Lang } from '../i18n';
interface Props { lang?: Lang; eyebrow?: string; title: string; lead: string; cta?: string; ctaHref?: string; secondary?: string; secondaryHref?: string; }
const { lang = 'nl', eyebrow, title, lead, secondary, secondaryHref } = Astro.props;
const cta = Astro.props.cta ?? ui[lang].cta;
const ctaHref = Astro.props.ctaHref ?? path(lang, 'request');
---
<section class="hero">
  <div class="wrap">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 set:html={title} />
    <p class="lead">{lead}</p>
    <div class="hero-actions">
      <a class="btn" href={ctaHref}>{cta}</a>
      {secondary && secondaryHref && <a class="btn btn-ghost" href={secondaryHref}>{secondary}</a>}
    </div>
    <slot />
  </div>
</section>
