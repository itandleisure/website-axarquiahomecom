---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import Todo from '../../components/Todo.astro';
import { site, isFilled } from '../../data/site';
import { team } from '../../data/team';
const c = site.company;
---
<Base
  title="Über uns: das Team für Ihr Haus in der Axarquía"
  description="Das Team hinter Axarquía Home: seit Jahren Renovierung, Instandhaltung und Hausbetreuung in Nerja, Cómpeta, Torrox und der übrigen Axarquía."
  path="/de/ueber-uns/"
  lang="de"
>
  <Breadcrumbs lang="de" items={[{ name: 'Über uns', href: '/de/ueber-uns/' }]} />
  <Hero
    lang="de"
    eyebrow="Über uns"
    title="Nordeuropäer, <em>die in der Axarquía bauen</em>"
    lead="Axarquía Home ist die erste Anlaufstelle für ausländische Eigentümer und Käufer. Die Arbeiten führt unser Partner aus, ein niederländisches Bauunternehmen, das seit Jahren in der Gegend lebt und arbeitet."
  />
  <section class="section">
    <div class="wrap split">
      <div class="prose">
        <h2>Unsere Geschichte</h2>
        <Todo label="het verhaal van het bouwbedrijf: sinds wanneer in Spanje, waarom, hoeveel mensen, waar gevestigd." />
        <p>Wir wissen, wie es ist, als Ausländer ein Haus in Spanien zu besitzen. Die Suche nach einem zuverlässigen Handwerker, Angebote, die nicht aufgehen, der Handwerker, der nicht kommt. Deshalb arbeiten wir anders: klare Absprachen, ein fester Ansprechpartner und Kommunikation in Ihrer Sprache.</p>
        <p>Wir verbinden nordeuropäische Standards mit Kenntnis der örtlichen Bauweise, Vorschriften und Handwerker. So können Sie Ihr Haus mit gutem Gefühl kaufen, renovieren und genießen, auch wenn Sie nicht da sind.</p>
      </div>
      <div class="box">
        <h3>Eckdaten</h3>
        <ul class="checks">
          <li>{c.name}</li>
          <li>{isFilled(c.town) ? `Sitz in ${c.town}` : c.town}</li>
          <li>{isFilled(c.yearsInRegion) ? `${c.yearsInRegion} Jahre in der Region` : c.yearsInRegion}</li>
          <li>Gebiet: {site.villages.join(', ')}</li>
          <li>Sprachen: Niederländisch, Englisch und Spanisch</li>
        </ul>
        <p class="note">Der Kontakt läuft auf Englisch oder Niederländisch.</p>
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap">
      <h2>Das Team</h2>
      {team.length === 0 && <Todo label="teamleden (zie src/data/team.ts), met een Duitse functie en bio." />}
      <div class="cards">
        {team.map((m) => (
          <div class="card">
            {m.photo && <img src={m.photo} alt={m.name} loading="lazy" width="400" height="400" style="border-radius:10px;margin-bottom:14px" />}
            <h3>{m.name}</h3>
            <p class="note">{m.roleDe ?? m.role}</p>
            <p>{m.bioDe ?? m.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <Cta lang="de" />
</Base>
