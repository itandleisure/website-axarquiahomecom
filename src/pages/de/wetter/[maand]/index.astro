---
import WeatherPage from '../../../../components/WeatherPage.astro';
import { monthSlugs } from '../../../../data/weather';

export function getStaticPaths() {
  return monthSlugs.de.map((maand, month) => ({ params: { maand }, props: { month } }));
}
const { month } = Astro.props as { month: number };
---
<WeatherPage lang="de" month={month} />
