const faq = [
  {
    q: 'Ist ein Haus mit AFO-Status legal?',
    a: 'Nicht ganz. AFO ist keine Legalisierung: Die Gemeinde erkennt nur an, dass sie nicht mehr einschreiten kann, weil die Frist von sechs Jahren abgelaufen ist. Sie dürfen darin wohnen, es verkaufen, eintragen lassen und an Wasser und Strom anschließen. Vergrößern dürfen Sie es nicht.',
  },
