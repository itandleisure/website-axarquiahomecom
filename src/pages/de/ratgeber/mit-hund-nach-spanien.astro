const faq = [
  {
    q: 'Was brauche ich, um meinen Hund nach Spanien mitzunehmen?',
    a: 'Einen Mikrochip, einen EU-Heimtierausweis und eine gültige Tollwutimpfung. Nach der ersten Tollwutimpfung müssen Sie 21 Tage warten, bevor Sie reisen, und ein Welpe muss bei der Impfung mindestens 12 Wochen alt sein. Eine Bandwurmbehandlung ist für Spanien nicht nötig.',
  },
  {
    q: 'Was kostet ein Tiertransport von Deutschland nach Spanien?',
    a: 'Für den Transport auf der Straße mit einem spezialisierten Tiertransporteur rechnen Sie meist mit 500 € bis 1.500 €, je nach Größe des Tieres, Entfernung und ob es eine geteilte oder eine eigene Fahrt ist.',
  },
  {
    q: 'Darf ich meinen Hund in Spanien allein zu Hause lassen?',
    a: 'Nicht lange. Das spanische Tierschutzgesetz (Ley 7/2023) bestimmt, dass ein Hund nicht länger als 24 Stunden am Stück allein sein darf, andere Haustiere nicht länger als drei Tage. Verreisen Sie ohne Ihr Tier, organisieren Sie eine Unterbringung oder jemanden, der täglich kommt.',
  },
  {
    q: 'Gibt es giftige Pflanzen in spanischen Gärten?',
