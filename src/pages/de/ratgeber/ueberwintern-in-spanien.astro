const faq = [
  {
    q: 'Wie lange darf ich als Deutscher in Spanien überwintern?',
    a: 'Als EU-Bürger gibt es keine feste Höchstdauer. Bleiben Sie länger als drei Monate, sind Sie verpflichtet, sich im Ausländerregister eintragen zu lassen. Achten Sie außerdem auf die 183-Tage-Grenze: Darüber werden Sie in der Regel in Spanien steuerpflichtig.',
  },
  {
    q: 'Bin ich in Spanien über meine Krankenkasse versichert?',
    a: 'Mit der Europäischen Krankenversicherungskarte (EHIC) auf der Rückseite Ihrer Gesundheitskarte haben Sie bei einem vorübergehenden Aufenthalt Anspruch auf medizinisch notwendige Behandlungen im öffentlichen spanischen System. Viele Auslandsreisekrankenversicherungen gelten nur für Reisen von einigen Wochen; für einen Aufenthalt von mehreren Monaten brauchen Sie oft einen eigenen Langzeittarif.',
  },
