const faq = [
  {
    q: 'Was kostet eine Autoversicherung in Spanien?',
    a: 'Eine Haftpflichtversicherung (terceros) kostet meist 250 € bis 450 € im Jahr, eine erweiterte Haftpflicht mit Glas, Brand und Diebstahl 350 € bis 650 € und eine Vollkasko (todo riesgo) 600 € bis 1.200 €. Alter, Wohnort, Fahrzeug und Schadenhistorie machen viel aus.',
  },
