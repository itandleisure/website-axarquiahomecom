const faq = [
  {
    q: 'Darf ich einen Handwerker in Spanien bar bezahlen?',
    a: 'Nur bei kleinen Beträgen. Zahlungen an Unternehmen oder Selbstständige sind ab 1.000 € in bar verboten. Können Sie nachweisen, dass Sie nicht in Spanien steuerlich ansässig sind, liegt die Grenze bei 10.000 €. Teilzahlungen für denselben Auftrag werden zusammengerechnet. Die Strafe beträgt 25% des Betrags und kann beide Seiten treffen.',
