const faq = [
  { q: 'Brauche ich in Spanien eine Genehmigung für eine Pergola?', a: 'Für eine freistehende Pergola ohne festes Dach reicht in vielen Gemeinden eine Anzeige (Declaración responsable), manchmal nicht einmal das. Bekommt sie ein festes Dach oder steht sie am Haus, gilt sie oft als Überdachung und braucht eine Genehmigung. Fragen Sie vorher bei der Gemeinde.' },
