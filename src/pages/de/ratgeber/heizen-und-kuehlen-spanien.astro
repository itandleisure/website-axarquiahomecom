    <tbody>
      <tr><td>Klimaanlage mit Wärmepumpe (Split)</td><td>Pro Raum, oder mehrere mit Multisplit</td><td>1.000 – 2.000 € pro Raum</td><td>± 0,05 – 0,06 €</td></tr>
      <tr><td>Aerotermia mit Fußbodenheizung</td><td>Ganzes Haus</td><td>10.000 – 20.000 €</td><td>± 0,05 – 0,06 €</td></tr>
