const faq = [
  {
    q: 'Ist die Renovierung eines Dorfhauses teuer?',
    a: 'Das hängt vor allem vom Zustand der Balken, des Dachs und der Mauern ab und von der Erreichbarkeit. Eine Komplettrenovierung ist eine große Investition; eine Auffrischung mit neuem Bad und neuer Küche kostet einen Bruchteil davon. Weil Material oft von Hand herangeschafft werden muss, ist jede Arbeit im Ortskern etwas teurer als anderswo. Nach einer Besichtigung bekommen Sie ein Angebot pro Position.',
  },
