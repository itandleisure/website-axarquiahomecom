const toc = [
  { id: 'ueberblick', label: 'Der Kalender in einer Tabelle' },
  { id: 'ibi', label: 'IBI und Müllgebühr (Gemeinde)' },
  { id: 'irnr', label: 'Steuer für Nichtresidenten (Formular 210)' },
  { id: 'vermoegen', label: 'Vermögensteuer' },
  { id: 'wohnland', label: 'Steuererklärung im Wohnland' },
  { id: 'zahlen', label: 'Zahlen aus dem Ausland' },
  { id: 'verpasst', label: 'Frist verpasst? So vermeiden Sie Zuschläge' },
  { id: 'quellen', label: 'Quellen' },
