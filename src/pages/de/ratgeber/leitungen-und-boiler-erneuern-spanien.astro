const faq = [
  {
    q: 'Sind Bleileitungen gefährlich?',
    a: 'Ja. Blei gelangt ins Trinkwasser, vor allem wenn das Wasser lange in der Leitung gestanden hat. Nach den neuen spanischen Trinkwasserregeln (RD 3/2023) müssen Bleileitungen ersetzt werden. Sehen Sie graue, weiche Rohre, die sich mit einem Schlüssel einritzen lassen, lassen Sie sie austauschen und trinken Sie bis dahin kein Leitungswasser.',
