---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import Services from '../../components/Services.astro';
import { prices, site, dePrice } from '../../data/site';

const faq = [
  {
    q: 'Was ist Hausbetreuung?',
    a: 'Wir verwahren einen Schlüssel zu Ihrem Haus und kontrollieren es regelmäßig, während Sie weg sind. Wir achten auf Undichtigkeiten, Feuchtigkeit, Stromausfälle und Einbrüche, lüften das Haus und schicken Ihnen einen kurzen Bericht mit Fotos. Gibt es ein Problem, kümmern wir uns nach Rücksprache mit Ihnen sofort darum.',
  },
  {
    q: 'Was kostet Hausbetreuung in Spanien?',
    a: 'Der Preis hängt davon ab, wie oft wir kommen und was wir sonst für Sie erledigen. Eine einfache Kontrolle alle zwei Wochen kostet meist einige zehn Euro im Monat; mit Garten, Pool und Reinigung mehr. Nach Ihrer Anfrage erhalten Sie ein Angebot nach Maß. Reparaturen und Reinigung darüber hinaus werden nur nach Ihrer Zustimmung berechnet.',
  },
  {
    q: 'Ist mein Schlüssel sicher?',
    a: 'Die Schlüssel werden codiert, ohne Adresse, in einem verschlossenen Tresor aufbewahrt. Nur feste Mitarbeiter haben Zugang, und jeder Besuch wird protokolliert.',
  },
  {
    q: 'Was passiert, wenn etwas kaputt ist?',
    a: 'Kleinigkeiten beheben wir sofort, die Kosten sehen Sie auf Ihrer Monatsrechnung. Bei größeren Reparaturen schicken wir zuerst Fotos und einen Preis. Weil wir auch ein Bauunternehmen sind, müssen Sie keine Handwerker suchen.',
  },
  {
    q: 'Kann ich monatlich kündigen?',
    a: 'Ja, die Hausbetreuung ist monatlich kündbar. Viele Eigentümer nutzen sie nur für die Monate, in denen sie in Deutschland sind.',
  },
  {
    q: 'Übernehmen Sie auch die Vermietungsverwaltung?',
    a: 'Ja. Vermieten Sie Ihr Haus als Ferienwohnung oder an einen festen Mieter, regeln wir alles vor Ort: Gäste empfangen und Absprachen treffen, Reinigung, Bettwäsche und Handtücher, Kontrollen nach der Abreise, Störungen und Reparaturen.',
  },
];

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Hausbetreuung und Schlüsselservice',
  provider: { '@id': `${site.url}/#bedrijf` },
  areaServed: 'Axarquía, Málaga, España',
  availableLanguage: ['de', 'nl', 'en'],
};
---
<Base
  title="Hausbetreuung in Spanien: Ihr Haus in der Axarquía, kontrolliert während Sie weg sind"
  description="Hausbetreuung und Schlüsselservice in Nerja, Cómpeta, Frigiliana, Torrox und der ganzen Axarquía. Regelmäßige Kontrollen, Fotoberichte und schnelle Hilfe nach Unwetter oder Wasserschaden. Monatlich kündbar."
  path="/de/hausbetreuung/"
  lang="de"
  jsonLd={[service]}
>
  <Breadcrumbs lang="de" items={[{ name: 'Hausbetreuung', href: '/de/hausbetreuung/' }]} />
  <Hero
    lang="de"
    eyebrow="Hausbetreuung und Schlüsselservice"
    title="Beruhigt <em>nach Hause fahren</em>"
    lead="Ihr Haus in Spanien steht einen großen Teil des Jahres leer. Wir behalten es im Blick, schicken Ihnen Fotos und greifen ein, wenn etwas nicht stimmt, bevor aus einem kleinen Leck eine große Reparatur wird."
    cta="Hausbetreuung anfragen"
    ctaHref="/de/anfrage/?dienst=sleutelbeheer"
  />

  <section class="section">
    <div class="wrap">
      <h2>Was wir für Sie tun</h2>
      <p class="section-intro">Wir stimmen die Betreuung auf Ihre Situation ab: wie oft, welche Extras und nur für die Monate, in denen Sie nicht da sind. Monatlich kündbar.</p>
      <ul class="checks">
        <li>Regelmäßige Kontrolle der Immobilie</li>
        <li>Fenster öffnen und lüften</li>
        <li>Prüfung auf Undichtigkeiten, Feuchtigkeit und Einbruch</li>
        <li>Kurzer Bericht mit Fotos nach jedem Besuch</li>
        <li>Zusätzliche Kontrolle nach Sturm oder Starkregen</li>
        <li>Post abholen und weiterleiten</li>
        <li>Haus vor Ihrer Ankunft vorbereiten</li>
        <li>Pool- und Gartenpflege</li>
        <li>Handwerker und Lieferungen hereinlassen</li>
        <li>Reinigung vor und nach Ihrem Aufenthalt</li>
      </ul>
      <p><a class="btn" href="/de/anfrage/?dienst=sleutelbeheer">Hausbetreuung anfragen</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap split">
      <div class="prose">
        <h2>Warum Hausbetreuung in der Axarquía wichtig ist</h2>
        <p>Ein leerstehendes Haus an der Costa del Sol hat es schwer. Im Winter bringt der Regen Undichtigkeiten und Feuchtigkeit, im Sommer sorgt die Hitze für Probleme mit Pool, Garten und Dach. Nach einem Sturm liegen Äste auf der Terrasse, oder ein Stromausfall lässt die Gefriertruhe auftauen.</p>
        <p>Siehe auch unsere Checklisten, um <a href="/de/ratgeber/haus-winterfest-spanien/">das Haus winterfest zu machen</a>, und was Sie zur <a href="/de/ratgeber/hausversicherung-spanien/">Versicherung bei Leerstand</a> wissen sollten.</p>
        <p>Ist niemand vor Ort, merken Sie das erst bei Ihrer Rückkehr. Mit Hausbetreuung sehen wir es innerhalb von ein bis zwei Wochen, nach Unwettern oft früher.</p>
        <h2>Mehr als nur ein Schlüssel</h2>
        <p>Weil wir auch das Bauunternehmen sind, können wir Probleme sofort beheben. Kein Suchen nach einem Klempner, der Sie versteht, kein Einholen von drei Angeboten aus der Ferne. Sie bekommen Fotos und einen Preis, und nach Ihrer Zustimmung wird es erledigt.</p>
        <p>Sie vermieten Ihr Haus? Dann übernehmen wir auch die Vermietung vor Ort: Gäste empfangen, Reinigung und Handtücher. Lesen Sie unseren Ratgeber <a href="/de/ratgeber/immobilie-in-spanien-vermieten/">Immobilie in Spanien vermieten</a> und den <a href="/de/ratgeber/steuerkalender-spanien/">Steuerkalender</a> zu den Fristen für IBI und Erklärungen.</p>
      </div>
      <div class="box">
        <h3>Was Sie nach jedem Besuch bekommen</h3>
        <ul class="checks">
          <li>Datum und Uhrzeit des Besuchs</li>
          <li>Fotos von jedem Raum und vom Außenbereich</li>
          <li>Zählerstände von Wasser und Strom</li>
          <li>Was uns aufgefallen ist und was wir getan haben</li>
          <li>Empfehlung, wenn etwas zu tun ist</li>
        </ul>
      </div>
    </div>
  </section>

  <Faq items={faq} lang="de" />
  <Cta lang="de" dienst="sleutelbeheer" title="Ihr Haus in guten Händen, während Sie weg sind" />
  <Services lang="de" exclude="hausbetreuung" title="Das könnte Sie auch interessieren" />
</Base>
