  { p: 'Hyra, lägenhet med 2 sovrum (långtid)', v: '750 – 1 300 €' },
  { p: 'Mat för två personer', v: '400 – 550 €' },
  { p: 'El (mer på sommaren på grund av luftkonditionering)', v: '60 – 130 €' },
  { p: 'Vatten och sophämtning', v: '25 – 50 €' },
  { p: 'Internet och två mobiler', v: '45 – 70 €' },
