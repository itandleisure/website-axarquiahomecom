const faq = [
  {
    q: 'Behöver jag vara i Spanien under renoveringen?',
    a: 'Nej. Det är klokt att vara där vid starten och vid överlämningen, eller att låta någon titta för din räkning. Däremellan kan du följa arbetet via foton, video och en enda kontaktperson.',
  },
  {
    q: 'Vilken förskottsbetalning är normal för en byggfirma i Spanien?',
