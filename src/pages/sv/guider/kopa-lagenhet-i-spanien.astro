const faq = [
  {
    q: 'Vad kostar det att köpa lägenhet i Spanien utöver priset?',
    a: 'För en begagnad lägenhet i Andalusien betalar du 7% överlåtelseskatt (ITP), plus ungefär 1 till 2% för notarie, register, advokat och eventuellt en gestor. För nyproduktion från en byggherre betalar du 10% moms och 1,2% stämpelskatt (AJD). Räkna totalt med 10 till 13% utöver priset.',
  },
  {
    q: 'Vad är en derrama?',
    a: 'En extra avgift som ägarföreningen tar ut för en stor utgift, till exempel ett nytt tak, en hiss eller renovering av fasaden. Är den beslutad före köpet, avtala i köpekontraktet vem som betalar. Annars hamnar den ofta på den nya ägaren.',
