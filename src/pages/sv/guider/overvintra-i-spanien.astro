const faq = [
  {
    q: 'Hur länge får jag som svensk övervintra i Spanien?',
    a: 'Som EU-medborgare finns ingen fast maxtid. Stannar du längre än tre månader ska du registrera dig i utlänningsregistret. Tänk också på gränsen på 183 dagar: över den blir du i regel skattskyldig i Spanien.',
  },
  {
    q: 'Gäller min svenska sjukförsäkring i Spanien?',
    a: 'Med det europeiska sjukförsäkringskortet från Försäkringskassan har du vid tillfällig vistelse rätt till nödvändig vård i den offentliga spanska vården. Kontrollera också din hemförsäkring eller reseförsäkring: många reseskydd gäller bara de första 45 eller 60 dagarna av en resa, och för en vistelse på flera månader kan du behöva ett tillägg.',
