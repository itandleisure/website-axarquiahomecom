const faq = [
  {
    q: 'Vad behöver jag för att ta med min hund till Spanien?',
    a: 'Ett mikrochip, ett EU-pass för sällskapsdjur och en giltig rabiesvaccination. Efter den första rabiesvaccinationen måste du vänta 21 dagar innan du reser, och en valp måste vara minst 12 veckor vid vaccinationen. Avmaskning mot dvärgbandmask krävs inte för Spanien och inte heller för hemresan till Sverige.',
  },
  {
    q: 'Vad kostar en djurtransport från Sverige till Spanien?',
    a: 'För transport på väg med en specialiserad djurtransportör får du oftast räkna med 700 till 2 000 €, beroende på djurets storlek, avståndet och om det är en delad eller en egen resa.',
  },
  {
    q: 'Får jag lämna min hund ensam hemma i Spanien?',
