  { id: 'regler', label: 'Spanska regler för hundar och katter' },
  { id: 'halsa', label: 'Hälsa: sandmyggor, processionsfjärilar och värme' },
  { id: 'hus', label: 'Hus och trädgård där djuret är säkert' },
