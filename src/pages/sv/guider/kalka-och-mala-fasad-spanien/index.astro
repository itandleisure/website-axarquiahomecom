  { id: 'kalk-eller-farg', label: 'Kalk eller fasadfärg?' },
  { id: 'vad-ingar', label: 'Vad ingår?' },
  { id: 'hur-ofta', label: 'Hur ofta på nytt?' },
  { id: 'regler', label: 'Kommunens krav' },
