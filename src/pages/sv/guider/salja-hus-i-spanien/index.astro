  { id: 'varfor', label: 'Därför lönar sig förberedelser' },
  { id: 'steg', label: 'Plan i fem faser' },
  { id: 'dokument', label: 'Dokument och legalisering' },
  { id: 'reparationer', label: 'Reparationer som lönar sig' },
  { id: 'kostnader', label: 'Kostnader för säljaren' },
  { id: 'distans', label: 'Sälja från utlandet' },
  { id: 'mer', label: 'Läs vidare' },
  { id: 'kallor', label: 'Källor' },
