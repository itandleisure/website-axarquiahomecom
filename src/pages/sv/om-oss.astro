---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import Todo from '../../components/Todo.astro';
import { site, isFilled } from '../../data/site';
import { team } from '../../data/team';
const c = site.company;
---
<Base
  title="Om oss: teamet för ditt hus i Axarquía"
  description="Möt teamet bakom Axarquía Home. Ett nederländskt byggföretag som i flera år har renoverat, underhållit och tagit hand om hus i Nerja, Torrox, Cómpeta och resten av Axarquía."
  path="/sv/om-oss/"
  lang="sv"
>
  <Breadcrumbs lang="sv" items={[{ name: 'Om oss', href: '/sv/om-oss/' }]} />
  <Hero
    lang="sv"
    eyebrow="Om oss"
    title="Nordeuropéer <em>som bygger i Axarquía</em>"
    lead="Axarquía Home är första kontakten för utländska ägare och köpare. Arbetet utförs av vår partner, ett nederländskt byggföretag som i flera år har bott och arbetat i trakten."
  />
  <section class="section">
    <div class="wrap split">
      <div class="prose">
        <h2>Vår historia</h2>
        <Todo label="het verhaal van het bouwbedrijf: sinds wanneer in Spanje, waarom, hoeveel mensen, waar gevestigd." />
        <p>Vi vet hur det är att äga ett hus i Spanien som utlänning. Att leta efter en pålitlig hantverkare, offerter som inte går ihop, hantverkaren som aldrig dyker upp. Därför arbetar vi annorlunda: tydliga överenskommelser, en fast kontaktperson och kommunikation som du förstår.</p>
        <p>Vi kombinerar nordeuropeisk standard med kunskap om lokalt byggsätt, regler och hantverkare. Så kan du köpa, renovera och njuta av ditt hus med gott samvete, även när du inte är där.</p>
      </div>
      <div class="box">
        <h3>Fakta</h3>
        <ul class="checks">
          <li>{c.name}</li>
          <li>{isFilled(c.town) ? `Säte i ${c.town}` : c.town}</li>
          <li>{isFilled(c.yearsInRegion) ? `${c.yearsInRegion} år i regionen` : c.yearsInRegion}</li>
          <li>Område: {site.villages.join(', ')}</li>
          <li>Språk: nederländska, engelska och spanska</li>
        </ul>
        <p class="note">Kontakten med dig sker på engelska.</p>
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap">
      <h2>Teamet</h2>
      {team.length === 0 && <Todo label="teamleden (zie src/data/team.ts), met een Zweedse functie en bio." />}
      <div class="cards">
        {team.map((m) => (
          <div class="card">
            {m.photo && <img src={m.photo} alt={m.name} loading="lazy" width="400" height="400" style="border-radius:10px;margin-bottom:14px" />}
            <h3>{m.name}</h3>
            <p class="note">{m.roleSv ?? m.roleEn ?? m.role}</p>
            <p>{m.bioSv ?? m.bioEn ?? m.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <Cta lang="sv" />
</Base>
