---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina niet gevonden" description="Deze pagina bestaat niet." path="/404/" noindex>
  <section class="hero">
    <div class="wrap narrow">
      <h1>Deze pagina bestaat niet (meer)</h1>
      <p class="lead">Misschien is de link verouderd. Ga naar de homepage of doe direct een aanvraag.</p>
      <div class="hero-actions"><a class="btn" href="/nl/">Naar de homepage</a><a class="btn btn-ghost" href="/nl/aanvraag/">Aanvraag doen</a></div>
    </div>
  </section>
</Base>
