---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import Todo from '../../components/Todo.astro';
import { site, isFilled } from '../../data/site';
import { team } from '../../data/team';
const c = site.company;
---
<Base
  title="About us: the English-speaking builders in the Axarquía"
  description="Meet the team behind Axarquía Home: years of renovation, maintenance and key holding in Nerja, Cómpeta, Torrox and the rest of the Axarquía."
  path="/en/about-us/"
  lang="en"
>
  <Breadcrumbs lang="en" items={[{ name: 'About us', href: '/en/about-us/' }]} />
  <Hero
    lang="en"
    eyebrow="About us"
    title="Northern Europeans <em>building in the Axarquía</em>"
    lead="Axarquía Home is the first point of contact for overseas owners and buyers. The work itself is carried out by our partner, a Dutch-owned building company that has lived and worked in the area for years."
  />
  <section class="section">
    <div class="wrap split">
      <div class="prose">
        <h2>Our story</h2>
        <Todo label="het verhaal van het bouwbedrijf: sinds wanneer in Spanje, waarom, hoeveel mensen, waar gevestigd." />
        <p>We know what it is like to own a home in Spain as a foreigner. The search for a reliable builder, the quotes that do not add up, the tradesman who never turns up. That is why we work differently: clear agreements, a named contact and communication in your own language.</p>
        <p>We combine Northern European standards with knowledge of local building methods, rules and tradespeople. So you can buy, renovate and enjoy your home with confidence, even when you are not there.</p>
      </div>
      <div class="box">
        <h3>Details</h3>
        <ul class="checks">
          <li>{c.name}</li>
          <li>{isFilled(c.town) ? `Based in ${c.town}` : c.town}</li>
          <li>{isFilled(c.yearsInRegion) ? `${c.yearsInRegion} years in the area` : c.yearsInRegion}</li>
          <li>Area: {site.villages.join(', ')}</li>
          <li>Languages: English, Dutch and Spanish</li>
        </ul>
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap">
      <h2>The team</h2>
      {team.length === 0 && <Todo label="teamleden (zie src/data/team.ts), met een Engelse functie en bio." />}
      <div class="cards">
        {team.map((m) => (
          <div class="card">
            {m.photo && <img src={m.photo} alt={m.name} loading="lazy" width="400" height="400" style="border-radius:10px;margin-bottom:14px" />}
            <h3>{m.name}</h3>
            <p class="note">{m.roleEn ?? m.role}</p>
            <p>{m.bioEn ?? m.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <Cta lang="en" />
</Base>
