---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Wizard from '../../components/Wizard.astro';
---
<Base
  title="Free quote: tell us what you have in mind"
  description="Make a free request in two minutes for renovation, key holding, a property survey, a pool or maintenance in the Axarquía."
  path="/en/request/"
  lang="en"
>
  <Breadcrumbs lang="en" items={[{ name: 'Request', href: '/en/request/' }]} />
  <section class="section" style="padding-top:28px">
    <div class="wrap">
      <h1>Your free request</h1>
      <p class="lead" style="margin-bottom:28px">Six short questions, about two minutes. A member of our English-speaking team will get back to you within 24 hours.</p>
      <Wizard lang="en" />
    </div>
  </section>
</Base>
