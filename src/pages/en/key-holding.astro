---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import Services from '../../components/Services.astro';
import Todo from '../../components/Todo.astro';
import { prices, site } from '../../data/site';

const p = prices.sleutelbeheer;
const packages = [
  { name: 'Basic', key: 'basis', price: p.basis, items: ['Property check every 2 weeks', 'Open windows and air the house', 'Check for leaks, damp and break-ins', 'Short report with photos', 'Key kept securely'] },
  { name: 'Plus', key: 'plus', price: p.plus, featured: true, items: ['Everything in Basic, but weekly', 'Extra check after storms or heavy rain', 'Collect and forward post', 'House made ready for your arrival', 'Small repairs sorted straight away'] },
  { name: 'Complete', key: 'compleet', price: p.compleet, items: ['Everything in Plus', 'Pool and garden looked after', 'Let in engineers and deliveries', 'Cleaning before and after your stay', 'Named contact on WhatsApp'] },
];

const faq = [
  {
    q: 'What is key holding?',
    a: 'We keep a key to your home and check it regularly while you are away. We look for leaks, damp, power cuts and break-ins, air the house and send you a short report with photos. If there is a problem, we deal with it straight away after checking with you.',
  },
  {
    q: 'How much does key holding cost in Spain?',
    a: 'A simple package with a check every two weeks usually costs a few tens of euros a month. Larger packages with garden, pool and cleaning cost more. You can see our packages above; repairs and cleaning outside the package are charged separately, only after you agree.',
  },
  {
    q: 'Is my key safe?',
    a: 'Keys are stored coded, with no address on them, in a locked safe. Only permanent staff have access, and every visit is logged.',
  },
  {
    q: 'What happens if something is broken?',
    a: 'Small things we fix straight away and you will see the cost on your monthly invoice. For bigger repairs we send photos and a price first. Because we are also a building company, you do not need to find tradespeople yourself.',
  },
  {
    q: 'Can I cancel monthly?',
    a: 'Yes, key holding can be cancelled monthly. Many owners only use it for the months they are back in the UK.',
  },
  {
    q: 'Do you also manage lettings?',
    a: 'Yes. If you let your home as a holiday let or to a long-term tenant, we handle everything on the spot: welcoming guests and making arrangements, cleaning, bed linen and towels, checks after departure, breakdowns and repairs.',
  },
];

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Key holding and property management',
  provider: { '@id': `${site.url}/#bedrijf` },
  areaServed: 'Axarquía, Málaga, España',
  availableLanguage: ['en', 'nl'],
};
---
<Base
  title="Key holding in Spain: your Axarquía home checked while you are away"
  description="Key holding and property checks in Nerja, Cómpeta, Frigiliana, Torrox and the whole Axarquía. Regular visits, photo reports and fast action after leaks or storms. English-speaking, cancel monthly."
  path="/en/key-holding/"
  lang="en"
  jsonLd={[service]}
>
  <Breadcrumbs lang="en" items={[{ name: 'Key holding', href: '/en/key-holding/' }]} />
  <Hero
    lang="en"
    eyebrow="Key holding and property checks"
    title="Head home <em>with peace of mind</em>"
    lead="Your home in Spain stands empty for much of the year. We keep an eye on it, send you photos and step in when something goes wrong, before a small leak becomes a big repair bill."
    cta="Arrange key holding"
    ctaHref="/en/request/?dienst=sleutelbeheer"
  />

  <section class="section">
    <div class="wrap">
      <h2>Our packages</h2>
      <p class="section-intro">Choose what suits you. All packages can be cancelled monthly and can cover just the months you are away.</p>
      <Todo label="pakketten en maandprijzen van het bouwbedrijf (de inhoud hieronder is een voorstel)." />
      <div class="packages">
        {packages.map((pk) => (
          <div class={`package${pk.featured ? ' featured' : ''}`}>
            <h3>{pk.name}</h3>
            <p class="price">{pk.price}</p>
            <ul class="checks">{pk.items.map((i) => <li>{i}</li>)}</ul>
            <a class={`btn${pk.featured ? '' : ' btn-ghost'}`} href={`/en/request/?dienst=sleutelbeheer&pakket=${pk.name.toLowerCase()}`}>Choose {pk.name}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap split">
      <div class="prose">
        <h2>Why key holding matters in the Axarquía</h2>
        <p>An empty house on the Costa del Sol has a hard time. In winter the rain brings leaks and damp; in summer the heat causes problems with the pool, garden and roof. After a storm there may be debris on the terrace, or a power cut that leaves the freezer defrosting.</p>
        <p>With nobody on site, you only find out when you come back. With key holding we see it within a week or two, and often sooner after bad weather.</p>
        <h2>More than holding a key</h2>
        <p>Because we are also the builders, we can fix problems straight away. No hunting for a plumber who speaks English, no chasing three quotes from the UK. You get photos and a price, and once you agree it is done.</p>
      </div>
      <div class="box">
        <h3>What you get after each visit</h3>
        <ul class="checks">
          <li>Date and time of the visit</li>
          <li>Photos of every room and the outside</li>
          <li>Water and electricity meter readings</li>
          <li>What we noticed and what we did</li>
          <li>Advice if something needs doing</li>
        </ul>
      </div>
    </div>
  </section>

  <Faq items={faq} lang="en" />
  <Cta lang="en" dienst="sleutelbeheer" title="Your home in good hands while you are away" />
  <Services lang="en" exclude="key-holding" title="You may also need" />
</Base>
