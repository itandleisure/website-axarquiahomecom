---
import MunicipalPage from '../../../../../components/MunicipalPage.astro';
import { places, type Place } from '../../../../../data/places';
import { hasMunicipalPages } from '../../../../../data/place-tabs';

export function getStaticPaths() {
  return places
    .filter((p) => hasMunicipalPages('en', p))
    .map((p) => ({ params: { slug: p.slug }, props: { place: p } }));
}
const { place } = Astro.props as { place: Place };
---
<MunicipalPage lang="en" place={place} kind="practical" />
