---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Hero from '../../../components/Hero.astro';
import Cta from '../../../components/Cta.astro';
import { guideList, guideHref } from '../../../data/guides';
---
<Base
  title="Guides: buying, renovating and living in Spain"
  description="Practical guides in English on moving to Spain from the UK, buying a home or finca, buying costs, renovation and legalisation in the Axarquía and the rest of Andalusia."
  path="/en/guides/"
  lang="en"
>
  <Breadcrumbs lang="en" items={[{ name: 'Guides', href: '/en/guides/' }]} />
  <Hero
    lang="en"
    eyebrow="Guides"
    title="What to know <em>before you buy or renovate</em>"
    lead="Written by people who live and build here. No sales talk, just the things British and other overseas owners actually run into in Spain."
    cta="Ask a question"
  />
  <section class="section">
    <div class="wrap">
      <div class="cards">
        <a class="card" href="/en/costs/"><h3>Costs by job</h3><p>What does a bathroom, kitchen, pool, air conditioning, roof or outdoor kitchen cost in the Axarquía? With worked examples and sources.</p><span class="more">See the prices →</span></a>
        <a class="card" href="/en/problems/"><h3>Problems with your home</h3><p>Damp, roof leaks, cracks, termites, legionella or break-ins: how to spot them, first steps and costs.</p><span class="more">See the problems →</span></a>
        {guideList('en').map((g) => (
          <a class="card" href={guideHref('en', g)}>
            <h3>{g.title}</h3>
            <p>{g.description}</p>
            <span class="more">Read the guide ({g.minutes} min) →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Cta lang="en" />
</Base>
