const faq = [
  {
    q: 'Will the police come if my alarm goes off?',
    a: 'Not automatically. In Spain the monitoring centre of a licensed security company only sends the police or Guardia Civil once the alarm is verified, for example with images, sound or several sensors going off. A standalone alarm without monitoring just makes noise and sends you a message.',
  },
  {
    q: 'Can my camera film the street?',
    a: 'No, only your own property. A small strip of street or the approach to your front door is allowed where unavoidable, but a camera covering the public road or the neighbours’ property breaks privacy law. Also put up a “zona videovigilada” sign.',
