---
import Base from '../../layouts/Base.astro';
---
<Base title="Thank you for your request" description="Your request has been received." path="/en/thank-you/" lang="en" noindex>
  <section class="hero">
    <div class="wrap narrow">
      <p class="eyebrow">Request received</p>
      <h1>Thank you, we will be in touch <em>within 24 hours</em></h1>
      <p class="lead">You will shortly receive a confirmation by email. A member of our team will look at your request and call or email you to arrange the next step.</p>
      <div class="hero-actions"><a class="btn btn-ghost" href="/en/">Back to the homepage</a></div>
    </div>
  </section>
</Base>
