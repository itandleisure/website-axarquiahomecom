---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import Services from '../../components/Services.astro';
import Todo from '../../components/Todo.astro';
import { prices, site, enPrice } from '../../data/site';

const faq = [
  {
    q: 'How much does it cost to build a pool in Spain?',
    a: `A concrete or block-built pool of average size, including equipment and finishing, usually costs between ${enPrice(prices.zwembadNieuw)}. The price depends on size, access to the plot, groundwork on a slope and extras such as heating or a salt system.`,
  },
  {
    q: 'Do I need permission for a pool?',
    a: 'Yes. A new pool needs a licence from the town hall, and stricter rules apply on rural land. Properties with AFO status often cannot have anything new built. We check this for you before you commit.',
  },
  {
    q: 'Can I fill my pool again?',
    a: 'The water restrictions in the Axarquía, including the ban on filling pools, were lifted in spring 2026 after a wet winter. Always check the current rules with your town hall; we can help with that.',
  },
  {
    q: 'My pool has been empty for two years. What now?',
    a: 'After a long period without water we often find cracks in the finish, loose tiles, dried-out grout and pumps that have seized. We start with an inspection and a leak test, then give you a price for the repairs.',
  },
  {
    q: 'Can you look after the pool while I am away?',
    a: 'Yes, as a separate maintenance contract or as part of our Complete key holding package. We check the water, clean the pool and keep an eye on the equipment.',
  },
];

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Swimming pool construction, renovation and maintenance',
  provider: { '@id': `${site.url}/#bedrijf` },
  areaServed: 'Axarquía, Málaga, España',
  availableLanguage: ['en', 'nl'],
};
---
<Base
  title="Pool building, renovation and maintenance in the Axarquía"
  description="Build a new pool, renovate an old one or have it maintained while you are away. English-speaking builders in Nerja, Cómpeta, Torrox and the Axarquía."
  path="/en/swimming-pool/"
  lang="en"
  jsonLd={[service]}
>
  <Breadcrumbs lang="en" items={[{ name: 'Swimming pools', href: '/en/swimming-pool/' }]} />
  <Hero
    lang="en"
    eyebrow="Swimming pools"
    title="Your pool <em>ready for summer</em>"
    lead="A new pool on your plot, an old one that needs to work again after the drought, or regular maintenance so the water is clear when you arrive."
    cta="Ask about a pool"
    ctaHref="/en/request/?dienst=zwembad"
    secondary="Work out the cost"
    secondaryHref="/en/costs/calculator/?klus=zwembad"
  />

  <section class="section">
    <div class="wrap">
      <div class="cards">
        <div class="card">
          <h2 class="h3">New pool</h2>
          <p>Design, licence, groundwork, construction and equipment. Sloping plots too, as with many fincas in the Axarquía.</p>
          <p><strong>{enPrice(prices.zwembadNieuw)}</strong></p>
        </div>
        <div class="card">
          <h2 class="h3">Pool renovation</h2>
          <p>Leak detection, new finish, tiles and grout, new pump and filter. After years of drought many pools need repair.</p>
          <p><strong>Price after inspection</strong></p>
        </div>
        <div class="card">
          <h2 class="h3">Maintenance</h2>
          <p>Regular visits for water, filter and equipment, even while you are in the UK. You get a photo after every visit.</p>
          <p><strong>{prices.zwembadOnderhoud}</strong></p>
        </div>
      </div>
      <Todo label="prijs zwembadonderhoud per maand en bevestiging prijs nieuwbouw." />
    </div>
  </section>

  <section class="section alt">
    <div class="wrap prose">
      <h2>After the drought: what happens to pools</h2>
      <p>Between 2023 and early 2026 pools in the Axarquía often could not be filled. A pool that stands empty for a long time suffers: the sun dries out the finish, grout comes loose and the ground around the pool can move. Refill it without an inspection and you risk a leak.</p>
      <p>That is why we start with an inspection and a leak test. Then you know exactly what needs doing and what it costs, before any water goes in.</p>
      <h2>Permission for a pool</h2>
      <p>A new pool as a rule needs a permit from the council, with a project by a technician. On rural land and with AFO houses, new construction is often not allowed. We check this beforehand and handle the application. More in our guide <a href="/en/guides/building-permits-renovation-andalusia/">renovating in Andalusia: which permit you need and who does what</a>.</p>
    </div>
  </section>

  <Faq items={faq} lang="en" />
  <Cta lang="en" dienst="zwembad" title="Thinking about a pool?" />
  <Services lang="en" exclude="swimming-pool" title="You may also need" />
</Base>
