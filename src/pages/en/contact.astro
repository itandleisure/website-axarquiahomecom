---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactForm from '../../components/ContactForm.astro';
import { contactTeksten } from '../../data/contactformulier';
const C = contactTeksten.en;
---
<Base
  title={C.title}
  description={C.description}
  path="/en/contact/"
  lang="en"
>
  <Breadcrumbs lang="en" items={[{ name: C.crumb, href: '/en/contact/' }]} />
  <section class="section" style="padding-top:28px">
    <div class="wrap">
      <h1>{C.h1}</h1>
      <p class="lead" style="margin-bottom:28px">{C.lead}</p>
      <ContactForm lang="en" />
    </div>
  </section>
</Base>
