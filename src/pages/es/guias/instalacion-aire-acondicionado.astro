const faq = [
  {
    q: '¿Cuánto cuesta instalar un aire acondicionado?',
    a: 'Un split de 2,5 a 3,5 kW para un dormitorio o un salón cuesta instalado entre 900 y 1.800 € sin IVA. Un multisplit con tres unidades interiores, entre 3.500 y 6.000 €. Un sistema por conductos para toda la casa, entre 6.000 y 12.000 €.',
  },
  {
    q: '¿El aire acondicionado también da calefacción?',
