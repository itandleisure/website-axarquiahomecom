---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import Todo from '../../components/Todo.astro';
import { site, isFilled } from '../../data/site';
import { team } from '../../data/team';
const c = site.company;
---
<Base
  title="Over ons: het Nederlandse bouwbedrijf in de Axarquía"
  description="Maak kennis met het Nederlandstalige team achter Axarquía Home. Al jaren actief in Nerja, Cómpeta, Torrox en de rest van de Axarquía, voor renovatie, onderhoud en sleutelbeheer."
  path="/nl/over-ons/"
>
  <Breadcrumbs items={[{ name: 'Over ons', href: '/nl/over-ons/' }]} />
  <Hero
    eyebrow="Over ons"
    title="Nederlanders die <em>in de Axarquía bouwen</em>"
    lead="Axarquía Home is het loket voor buitenlandse eigenaren en kopers. De uitvoering ligt in handen van ons vaste Nederlandse bouwbedrijf, dat al jaren in de regio woont en werkt."
  />
  <section class="section">
    <div class="wrap split">
      <div class="prose">
        <h2>Ons verhaal</h2>
        <Todo label="het verhaal van het bouwbedrijf: sinds wanneer in Spanje, waarom, hoeveel mensen, waar gevestigd." />
        <p>Wij weten hoe het is om als Nederlander in Spanje een huis te hebben. De zoektocht naar een betrouwbare aannemer, de offertes die niet kloppen, de vakman die niet komt opdagen. Daarom werken wij anders: met duidelijke afspraken, een vaste contactpersoon en communicatie in uw eigen taal.</p>
        <p>We combineren Nederlandse degelijkheid met kennis van de lokale bouw, regels en vakmensen. Zo kunt u met een gerust hart kopen, verbouwen en genieten van uw huis, ook als u er niet bent.</p>
      </div>
      <div class="box">
        <h3>Gegevens</h3>
        <ul class="checks">
          <li>{c.name}</li>
          <li>{isFilled(c.town) ? `Gevestigd in ${c.town}` : c.town}</li>
          <li>{isFilled(c.yearsInRegion) ? `${c.yearsInRegion} jaar actief in de regio` : c.yearsInRegion}</li>
          <li>Werkgebied: {site.villages.join(', ')}</li>
          <li>Talen: Nederlands, Engels en Spaans</li>
        </ul>
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap">
      <h2>Het team</h2>
      {team.length === 0 && <Todo label="namen, functies, foto’s en een paar zinnen per persoon. Zet ze in src/data/team.ts en de foto’s in public/team/." />}
      <div class="cards">
        {team.map((m) => (
          <div class="card">
            {m.photo && <img src={m.photo} alt={m.name} loading="lazy" width="400" height="400" style="border-radius:10px;margin-bottom:14px" />}
            <h3>{m.name}</h3>
            <p class="note">{m.role}</p>
            <p>{m.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <Cta />
</Base>
