---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Wizard from '../../components/Wizard.astro';
---
<Base
  title="Gratis aanvraag: vertel ons wat u van plan bent"
  description="Doe in twee minuten een gratis aanvraag voor renovatie, sleutelbeheer, aankoopkeuring, zwembad of onderhoud in de Axarquía. Binnen 24 uur reactie van een Nederlandstalige collega."
  path="/nl/aanvraag/"
>
  <Breadcrumbs items={[{ name: 'Aanvraag', href: '/nl/aanvraag/' }]} />
  <section class="section" style="padding-top:28px">
    <div class="wrap">
      <h1>Uw gratis aanvraag</h1>
      <p class="lead" style="margin-bottom:28px">Zes korte vragen, ongeveer twee minuten. Daarna neemt een Nederlandstalige collega binnen 24 uur contact met u op.</p>

      <Wizard lang="nl" />
    </div>
  </section>
</Base>

