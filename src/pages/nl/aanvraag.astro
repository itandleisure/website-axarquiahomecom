---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site, isFilled } from '../../data/site';

const endpoint = isFilled(site.leadEndpoint) ? site.leadEndpoint : '';

const diensten = [
  { v: 'renovatie', t: 'Renovatie of verbouwing', s: 'Hele woning of een deel' },
  { v: 'badkamer-keuken', t: 'Badkamer of keuken', s: 'Vernieuwen of verbouwen' },
  { v: 'sleutelbeheer', t: 'Sleutelbeheer', s: 'Toezicht als u weg bent' },
  { v: 'aankoopkeuring', t: 'Aankoopkeuring', s: 'Keuring vóór de koop' },
  { v: 'zwembad', t: 'Zwembad', s: 'Bouwen, herstellen of onderhoud' },
  { v: 'onderhoud', t: 'Reparatie of onderhoud', s: 'Dak, lekkage, perceel, tuin' },
  { v: 'legalisatie', t: 'Vergunning of legalisatie', s: 'AFO, aanbouw, energielabel' },
  { v: 'anders', t: 'Iets anders', s: 'Zonnepanelen, airco, verhuizen…' },
];
const situaties = [
  { v: 'eigenaar', t: 'Ik heb al een huis in Spanje' },
  { v: 'koper', t: 'Ik ga een huis kopen', s: 'Of ik heb er een op het oog' },
  { v: 'orienterend', t: 'Ik oriënteer me nog' },
];
const typen = ['Appartement', 'Dorpshuis', 'Villa', 'Finca of landhuis', 'Anders'];
const planning = ['Zo snel mogelijk', 'Binnen 3 maanden', 'Over 3 tot 6 maanden', 'Over meer dan 6 maanden', 'Weet ik nog niet'];
const budgetten = ['Tot € 5.000', '€ 5.000 – € 20.000', '€ 20.000 – € 50.000', '€ 50.000 – € 100.000', 'Meer dan € 100.000', 'Weet ik nog niet'];
---
<Base
  title="Gratis aanvraag: vertel ons wat u van plan bent"
  description="Doe in twee minuten een gratis aanvraag voor renovatie, sleutelbeheer, aankoopkeuring, zwembad of onderhoud in de Axarquía. Binnen 24 uur reactie van een Nederlandstalige collega."
  path="/nl/aanvraag/"
>
  <Breadcrumbs items={[{ name: 'Aanvraag', href: '/nl/aanvraag/' }]} />
  <section class="section" style="padding-top:28px">
    <div class="wrap">
      <h1>Uw gratis aanvraag</h1>
      <p class="lead" style="margin-bottom:28px">Zes korte vragen, ongeveer twee minuten. Daarna neemt een Nederlandstalige collega binnen 24 uur contact met u op.</p>

      <form id="keuzehulp" class="wizard" data-endpoint={endpoint} novalidate>
        <div class="step-count" aria-live="polite">Stap <span data-current>1</span> van <span data-total>6</span></div>
        <div class="progress" aria-hidden="true"><span></span></div>

        <fieldset class="wstep" data-step="1">
          <legend>Waarmee kunnen we u helpen?</legend>
          <div class="choices">
            {diensten.map((d) => (
              <label class="choice"><input type="radio" name="dienst" value={d.v} required /><span>{d.t}<small>{d.s}</small></span></label>
            ))}
          </div>
        </fieldset>

        <fieldset class="wstep" data-step="2" hidden>
          <legend>Wat is uw situatie?</legend>
          <div class="choices">
            {situaties.map((d) => (
              <label class="choice"><input type="radio" name="situatie" value={d.v} required /><span>{d.t}{d.s && <small>{d.s}</small>}</span></label>
            ))}
          </div>
          <div class="field" style="margin-top:20px">
            <label for="type">Om wat voor woning gaat het?</label>
            <select id="type" name="type_woning">
              <option value="">Kies een type</option>
              {typen.map((t) => <option>{t}</option>)}
            </select>
          </div>
        </fieldset>

        <fieldset class="wstep" data-step="3" hidden>
          <legend>Waar staat de woning?</legend>
          <div class="field">
            <label for="plaats">Plaats</label>
            <select id="plaats" name="plaats" required>
              <option value="">Kies een plaats</option>
              {site.villages.map((v) => <option>{v}</option>)}
              <option>Andere plaats in de Axarquía</option>
              <option>Elders in de provincie Málaga</option>
              <option>Weet ik nog niet</option>
            </select>
          </div>
          <div class="field">
            <label for="adres">Adres of link naar de woning <span class="note">(optioneel)</span></label>
            <input id="adres" name="adres" type="text" autocomplete="street-address" placeholder="Bijvoorbeeld een link van Idealista of Kyero" />
          </div>
        </fieldset>

        <fieldset class="wstep" data-step="4" hidden>
          <legend>Wanneer en met welk budget?</legend>
          <div class="field">
            <label for="planning">Wanneer wilt u beginnen?</label>
            <select id="planning" name="planning" required>
              <option value="">Kies</option>
              {planning.map((p) => <option>{p}</option>)}
            </select>
          </div>
          <div class="field" data-budget>
            <label for="budget">Welk budget heeft u ongeveer in gedachten?</label>
            <select id="budget" name="budget">
              <option value="">Kies (optioneel)</option>
              {budgetten.map((b) => <option>{b}</option>)}
            </select>
            <p class="hint">Dit helpt ons om u direct een realistisch voorstel te doen.</p>
          </div>
        </fieldset>

        <fieldset class="wstep" data-step="5" hidden>
          <legend>Vertel iets meer</legend>
          <div class="field">
            <label for="omschrijving">Wat wilt u laten doen?</label>
            <textarea id="omschrijving" name="omschrijving" rows="5" placeholder="Bijvoorbeeld: badkamer en keuken vernieuwen, dakterras lekt, sleutelbeheer van oktober tot april…"></textarea>
          </div>
          <div class="field">
            <label for="fotos">Foto’s <span class="note">(optioneel, maximaal 5)</span></label>
            <input id="fotos" type="file" accept="image/*" multiple />
            <p class="hint">Foto’s helpen ons om sneller een prijs te geven.</p>
            <div class="thumbs" data-thumbs></div>
          </div>
        </fieldset>

        <fieldset class="wstep" data-step="6" hidden>
          <legend>Hoe kunnen we u bereiken?</legend>
          <div class="row2">
            <div class="field"><label for="naam">Naam</label><input id="naam" name="naam" type="text" autocomplete="name" required /></div>
            <div class="field"><label for="email">E-mail</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
            <div class="field"><label for="telefoon">Telefoon</label><input id="telefoon" name="telefoon" type="tel" autocomplete="tel" placeholder="+31 6 … of +34 …" required /></div>
            <div class="field">
              <label for="contact">Hoe wilt u benaderd worden?</label>
              <select id="contact" name="contactvoorkeur">
                <option>Bellen</option><option>WhatsApp</option><option>E-mail</option>
              </select>
            </div>
          </div>
          <div class="hp" aria-hidden="true"><label>Laat dit veld leeg <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
          <label class="consent"><input type="checkbox" name="toestemming" value="ja" required /><span>Ik geef toestemming dat mijn aanvraag wordt doorgestuurd naar het bouwbedrijf van Axarquía Home, dat contact met mij opneemt. Zie de <a href="/nl/privacy/" target="_blank">privacyverklaring</a>.</span></label>
          <label class="consent"><input type="checkbox" name="toestemming_partner" value="ja" /><span>Als mijn vraag buiten het werk van het bouwbedrijf valt, mag mijn aanvraag naar één andere vakpartner. <span class="note">(optioneel)</span></span></label>
        </fieldset>

        <p class="wizard-error" role="alert" data-error></p>
        <div class="wizard-nav">
          <button type="button" class="btn btn-ghost" data-prev hidden>Vorige</button>
          <button type="button" class="btn" data-next style="margin-left:auto">Volgende</button>
          <button type="submit" class="btn" data-submit hidden style="margin-left:auto">Verstuur aanvraag</button>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('keuzehulp') as HTMLFormElement;
  const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>('.wstep'));
  const prev = form.querySelector<HTMLButtonElement>('[data-prev]')!;
  const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const errorEl = form.querySelector<HTMLElement>('[data-error]')!;
  const bar = form.querySelector<HTMLElement>('.progress span')!;
  const cur = form.querySelector<HTMLElement>('[data-current]')!;
  const fotoInput = form.querySelector<HTMLInputElement>('#fotos')!;
  const thumbs = form.querySelector<HTMLElement>('[data-thumbs]')!;
  let index = 0;
  let photos: { name: string; type: string; data: string }[] = [];

  // Voorkeuze via ?dienst=…&pakket=…
  const params = new URLSearchParams(location.search);
  const pre = params.get('dienst');
  if (pre) {
    const r = form.querySelector<HTMLInputElement>(`input[name="dienst"][value="${CSS.escape(pre)}"]`);
    if (r) r.checked = true;
  }
  const pakket = params.get('pakket');
  if (pakket) {
    const t = form.querySelector<HTMLTextAreaElement>('#omschrijving')!;
    t.value = `Interesse in sleutelbeheer, pakket ${pakket}.`;
  }

  function show(i: number) {
    index = i;
    steps.forEach((s, n) => (s.hidden = n !== i));
    prev.hidden = i === 0;
    next.hidden = i === steps.length - 1;
    submit.hidden = i !== steps.length - 1;
    bar.style.width = `${((i + 1) / steps.length) * 100}%`;
    cur.textContent = String(i + 1);
    errorEl.textContent = '';
    // Budget is niet relevant bij sleutelbeheer en keuring
    const dienst = (form.elements.namedItem('dienst') as RadioNodeList).value;
    const budget = form.querySelector<HTMLElement>('[data-budget]')!;
    budget.hidden = dienst === 'sleutelbeheer' || dienst === 'aankoopkeuring';
  }

  function valid(i: number): boolean {
    const fields = Array.from(steps[i].querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]'));
    for (const f of fields) {
      if (f instanceof HTMLInputElement && f.type === 'radio') {
        if (!(form.elements.namedItem(f.name) as RadioNodeList).value) {
          errorEl.textContent = 'Kies een van de opties om verder te gaan.';
          return false;
        }
      } else if (f instanceof HTMLInputElement && f.type === 'checkbox') {
        if (!f.checked) { errorEl.textContent = 'Geef toestemming om uw aanvraag door te sturen.'; return false; }
      } else if (!f.value.trim() || !f.checkValidity()) {
        const label = form.querySelector(`label[for="${f.id}"]`)?.textContent?.trim() ?? 'dit veld';
        errorEl.textContent = `Vul ${label.toLowerCase()} in.`;
        f.focus();
        return false;
      }
    }
    return true;
  }

  next.addEventListener('click', () => { if (valid(index)) show(index + 1); });
  prev.addEventListener('click', () => show(index - 1));
  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.type === 'radio' && index < 2) setTimeout(() => valid(index) && show(index + 1), 180);
  });

  // Foto's verkleinen in de browser (max. 1600 px) zodat het versturen snel gaat
  async function resize(file: File): Promise<{ name: string; type: string; data: string }> {
    const img = await createImageBitmap(file);
    const scale = Math.min(1, 1600 / Math.max(img.width, img.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(img.width * scale);
    canvas.height = Math.round(img.height * scale);
    canvas.getContext('2d')!.drawImage(img, 0, 0, canvas.width, canvas.height);
    const dataUrl = canvas.toDataURL('image/jpeg', 0.8);
    return { name: file.name.replace(/\.[^.]+$/, '') + '.jpg', type: 'image/jpeg', data: dataUrl.split(',')[1] };
  }
  fotoInput.addEventListener('change', async () => {
    const files = Array.from(fotoInput.files ?? []).slice(0, 5);
    thumbs.innerHTML = '';
    photos = [];
    for (const f of files) {
      try {
        const p = await resize(f);
        photos.push(p);
        const im = document.createElement('img');
        im.src = `data:image/jpeg;base64,${p.data}`;
        im.alt = f.name;
        thumbs.appendChild(im);
      } catch { /* bestand overslaan als het geen bruikbare foto is */ }
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!valid(index)) return;
    const endpoint = form.dataset.endpoint;
    const data: Record<string, unknown> = Object.fromEntries(new FormData(form).entries());
    if (data.website) return; // spam
    delete data.website;
    data.taal = document.documentElement.lang;
    data.pagina = document.referrer || location.href;
    data.utm = location.search;
    data.fotos = photos;
    // Uniek id: het script negeert een tweede inzending met hetzelfde id
    data.id = (crypto.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`);

    if (!endpoint) {
      errorEl.textContent = 'Het formulier is nog niet gekoppeld (testversie). Uw aanvraag is niet verstuurd.';
      console.info('Aanvraag (niet verstuurd):', data);
      return;
    }
    submit.disabled = true;
    submit.textContent = 'Bezig met versturen…';
    const body = JSON.stringify(data);
    try {
      // text/plain voorkomt een CORS-preflight bij Google Apps Script
      const res = await fetch(endpoint, { method: 'POST', body, headers: { 'Content-Type': 'text/plain;charset=utf-8' } });
      const json = await res.json().catch(() => ({ ok: res.ok }));
      if (!json.ok) throw new Error(json.error || 'Versturen mislukt');
      location.href = '/nl/bedankt/';
    } catch {
      try {
        await fetch(endpoint, { method: 'POST', body, mode: 'no-cors', headers: { 'Content-Type': 'text/plain;charset=utf-8' } });
        location.href = '/nl/bedankt/';
      } catch {
        submit.disabled = false;
        submit.textContent = 'Verstuur aanvraag';
        errorEl.textContent = 'Versturen is niet gelukt. Controleer uw internetverbinding of mail ons op info@axarquiahome.com.';
      }
    }
  });

  show(0);
</script>
