---
import Base from '../../layouts/Base.astro';
---
<Base title="Bedankt voor uw aanvraag" description="Uw aanvraag is ontvangen." path="/nl/bedankt/" noindex>
  <section class="hero">
    <div class="wrap narrow">
      <p class="eyebrow">Aanvraag ontvangen</p>
      <h1>Bedankt, we nemen <em>binnen 24 uur</em> contact op</h1>
      <p class="lead">U ontvangt zo een bevestiging per e-mail. Een Nederlandstalige collega bekijkt uw aanvraag en belt of mailt u om de volgende stap af te spreken.</p>
      <div class="hero-actions"><a class="btn btn-ghost" href="/nl/">Terug naar de homepage</a></div>
    </div>
  </section>
</Base>
