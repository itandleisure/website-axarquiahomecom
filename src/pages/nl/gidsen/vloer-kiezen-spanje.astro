    <tbody>
      <tr><td>Keramische tegel (gres porcelánico)</td><td class="pk">€€</td><td>Sterk, waterbestendig, koel, onderhoudsvrij</td><td>Koud in de winter, voegen</td></tr>
      <tr><td>Grote tegels (bijv. 120 × 60 cm of groter)</td><td class="pk">€€€</td><td>Strak, weinig voegen, ruimtelijk</td><td>Vraagt een heel vlakke ondergrond en vakwerk</td></tr>
