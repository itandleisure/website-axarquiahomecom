const faq = [
  {
    q: 'Wat heb ik nodig om mijn hond mee te nemen naar Spanje?',
    a: 'Een chip, een Europees dierenpaspoort en een geldige vaccinatie tegen rabiës. Bij de eerste rabiësvaccinatie moet u 21 dagen wachten voor u reist, en een pup moet bij die vaccinatie minimaal 12 weken oud zijn. Een behandeling tegen lintworm is voor Spanje niet nodig.',
  },
  {
    q: 'Wat kost een dierenvervoerder van Nederland naar Spanje?',
    a: 'Voor vervoer over de weg met een gespecialiseerde dierenvervoerder rekent u meestal op € 500 tot € 1.500, afhankelijk van de grootte van het dier, de afstand en of het een gedeelde of een eigen rit is.',
  },
  {
    q: 'Mag ik mijn hond in Spanje alleen thuislaten?',
