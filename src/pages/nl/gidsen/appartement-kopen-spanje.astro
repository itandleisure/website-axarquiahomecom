const faq = [
  {
    q: 'Wat kost een appartement kopen in Spanje bovenop de koopprijs?',
    a: 'Bij een bestaand appartement in Andalusië betaalt u 7% overdrachtsbelasting (ITP), plus ongeveer 1 tot 2% voor notaris, register, advocaat en eventueel een gestor. Bij nieuwbouw van een projectontwikkelaar betaalt u 10% btw en 1,2% zegelbelasting (AJD). Reken in totaal op 10 tot 13% bovenop de prijs.',
  },
  {
    q: 'Wat is een derrama?',
    a: 'Een extra heffing die de vereniging van eigenaars oplegt voor een grote uitgave, zoals een nieuw dak, een lift of herstel van de gevel. Is die al besloten vóór de koop, spreek dan in het koopcontract af wie hem betaalt. Anders komt hij vaak voor de nieuwe eigenaar.',
  },
  {
    q: 'Mag ik mijn appartement verhuren aan toeristen?',
