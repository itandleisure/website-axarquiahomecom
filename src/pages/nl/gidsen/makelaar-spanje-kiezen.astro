const faq = [
  {
    q: 'Is makelaar in Spanje een beschermd beroep?',
    a: 'Nee. In Andalusië kan in principe iedereen huizen verkopen. Lidmaatschap van een beroepsvereniging, zoals de API of het Colegio de Agentes de la Propiedad Inmobiliaria, is vrijwillig. Vraag daarom naar ervaring, referenties en een verzekering voor beroepsaansprakelijkheid.',
  },
  {
    q: 'Hoeveel courtage rekent een makelaar in Spanje?',
