const faq = [
  {
    q: 'Wat levert isoleren op in een warm land?',
    a: 'Meer dan u denkt. Een goed geïsoleerd dak houdt ’s zomers de hitte buiten en ’s winters de warmte binnen. In een ongeïsoleerd huis in de Axarquía bespaart u met dak- en muurisolatie vaak 30 tot 50% op verwarmen en koelen, en het huis voelt in beide seizoenen veel prettiger.',
