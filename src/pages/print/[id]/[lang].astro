---
// Printversie van elke gratis checklist (src/data/checklists.ts). Wordt met `npm run pdf` omgezet naar
// public/downloads/<pdf>. Staat ook online (/print/<id>/<taal>/), maar met noindex.
// Foto's: stockfoto's uit Canva Pro (zie src/data/place-photos.ts) als jpg in public/images/print/, relatief gelinkt
// zodat ze zowel online als vanaf dist/ (file://) laden.
import { checklists, checklistIds, printPhotos, type ChecklistId } from '../../../data/checklists';
import { site } from '../../../data/site';
import { topicPhoto } from '../../../data/topic-photos';
import { langs, path, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return checklistIds.flatMap((id) => langs.filter((lang) => checklists[id][lang]).map((lang) => ({ params: { id, lang } })));
}
const id = Astro.params.id as ChecklistId;
const lang = Astro.params.lang as Lang;
const c = checklists[id][lang]!;
const ph = printPhotos[id];
const utm = `utm_source=checklist&utm_medium=pdf&utm_campaign=${id}`;
const requestUrl = `${site.url}${path(lang, 'request')}?dienst=${c.cta.dienst ?? 'aankoopkeuring'}&${utm}`;
const shortUrl = `${site.domain}${path(lang, 'request')}`;

// Jpg-kopieën in public/images/print/ (uit de webp-foto's), zodat de pdf klein blijft
const img = (name: string) => `../../../images/print/${name}.jpg`;

type T = { welcomeTitle: string; welcome: string[]; welcomeOther: string; spot: string; spotIntro: string; captions: Record<string, string> };
const extra: Record<string, T> = {
  nl: {
    welcomeTitle: 'Welkom in de Axarquía',
    welcome: [
      'Witte dorpen tegen de bergen, terrassen vol olijf-, amandel- en avocadobomen en een kust met kleine baaien onder de kliffen. De Axarquía, ten oosten van Málaga, is een van de mooiste plekken van Andalusië om te wonen.',
      'Met zo’n 300 dagen zon per jaar, het vliegveld van Málaga op ongeveer een uur rijden en dorpen als Frigiliana, Cómpeta en Nerja begrijpt u waarom steeds meer Nederlanders, Duitsers, Zweden en Britten hier een huis kopen. Deze checklist helpt u om dat met een gerust hart te doen.',
    ],
    welcomeOther: 'Met zo’n 300 dagen zon per jaar, het vliegveld van Málaga op ongeveer een uur rijden en dorpen als Frigiliana, Cómpeta en Nerja begrijpt u waarom zoveel Nederlanders, Duitsers, Zweden en Britten hier een huis hebben. Een huis in deze streek vraagt wel om de juiste aanpak, en daar helpt deze checklist bij.',
    spot: 'Herkent u dit?',
    spotIntro: 'Vocht en lekkages zijn de meest voorkomende verborgen gebreken in huizen in de Axarquía. Een verse laag verf verstopt ze vaak tijdens de bezichtiging.',
    captions: {
      'competa-panorama-sierra-almijara': 'Cómpeta, met de Sierra Almijara',
      'frigiliana-blauwe-deuren': 'Frigiliana',
      'nerja-baai-strand-kliffen': 'Een baai onder de kliffen van Nerja',
      'canillas-de-albaida-balkons-bloemen': 'Canillas de Albaida',
      'canillas-de-albaida-pleintje-kerk': 'Het dorpsplein van Canillas de Albaida',
      'competa-kerktoren-dorp': 'Cómpeta',
      'canillas-de-albaida-uitzicht-dal': 'Uitzicht over het dal bij Canillas de Albaida',
      'frigiliana-panorama-witte-dorp': 'Frigiliana tegen de berghelling',
      'frigiliana-trappen-oude-wijk': 'Trappen in de oude wijk van Frigiliana',
      'nerja-strand-kustlijn': 'De kust bij Nerja',
      'nerja-uitzicht-bougainville': 'Bougainville in Nerja',
      'vocht-afbladderende-verf-muur': 'Opstijgend vocht: afbladderende verf onderaan de muur',
      'lekkage-vlek-plafond-hoek': 'Lekkage: een vochtvlek in de hoek van het plafond',
    },
  },
  en: {
    welcomeTitle: 'Welcome to the Axarquía',
    welcome: [
      'White villages against the mountains, terraces full of olive, almond and avocado trees, and a coastline of little coves beneath the cliffs. The Axarquía, east of Málaga, is one of the most beautiful places in Andalusia to live.',
      'With around 300 days of sunshine a year, Málaga airport about an hour’s drive away and villages such as Frigiliana, Cómpeta and Nerja, it is easy to see why more and more Dutch, German, Swedish and British buyers settle here. This checklist helps you do it with peace of mind.',
    ],
    welcomeOther: 'With around 300 days of sunshine a year, Málaga airport about an hour’s drive away and villages such as Frigiliana, Cómpeta and Nerja, it is easy to see why so many Dutch, German, Swedish and British people have a home here. A house in this region does need the right approach, and that is what this checklist helps with.',
    spot: 'Do you recognise this?',
    spotIntro: 'Damp and leaks are the most common hidden defects in homes in the Axarquía. A fresh coat of paint often hides them during a viewing.',
    captions: {
      'competa-panorama-sierra-almijara': 'Cómpeta and the Sierra Almijara',
      'frigiliana-blauwe-deuren': 'Frigiliana',
      'nerja-baai-strand-kliffen': 'A cove below the cliffs of Nerja',
      'canillas-de-albaida-balkons-bloemen': 'Canillas de Albaida',
      'canillas-de-albaida-pleintje-kerk': 'The village square of Canillas de Albaida',
      'competa-kerktoren-dorp': 'Cómpeta',
      'canillas-de-albaida-uitzicht-dal': 'The valley below Canillas de Albaida',
      'frigiliana-panorama-witte-dorp': 'Frigiliana on the mountainside',
      'frigiliana-trappen-oude-wijk': 'Steps in the old quarter of Frigiliana',
      'nerja-strand-kustlijn': 'The coast at Nerja',
      'nerja-uitzicht-bougainville': 'Bougainvillea in Nerja',
      'vocht-afbladderende-verf-muur': 'Rising damp: flaking paint at the bottom of a wall',
      'lekkage-vlek-plafond-hoek': 'A leak: a damp stain in the corner of the ceiling',
    },
  },
  de: {
    welcomeTitle: 'Willkommen in der Axarquía',
    welcome: [
      'Weiße Dörfer vor den Bergen, Terrassen voller Oliven-, Mandel- und Avocadobäume und eine Küste mit kleinen Buchten unter den Klippen. Die Axarquía östlich von Málaga gehört zu den schönsten Orten Andalusiens zum Leben.',
      'Mit rund 300 Sonnentagen im Jahr, dem Flughafen Málaga in etwa einer Stunde Fahrt und Dörfern wie Frigiliana, Cómpeta und Nerja verstehen Sie, warum immer mehr Deutsche, Niederländer, Schweden und Briten hier ein Haus kaufen. Diese Checkliste hilft Ihnen, das mit gutem Gefühl zu tun.',
    ],
    welcomeOther: 'Mit rund 300 Sonnentagen im Jahr, dem Flughafen Málaga in etwa einer Stunde Fahrt und Dörfern wie Frigiliana, Cómpeta und Nerja verstehen Sie, warum so viele Deutsche, Niederländer, Schweden und Briten hier ein Haus haben. Ein Haus in dieser Gegend braucht aber die richtige Herangehensweise, und dabei hilft diese Checkliste.',
    spot: 'Kommt Ihnen das bekannt vor?',
    spotIntro: 'Feuchtigkeit und Lecks sind die häufigsten versteckten Mängel in Häusern der Axarquía. Ein frischer Anstrich verdeckt sie bei der Besichtigung oft.',
    captions: {
      'competa-panorama-sierra-almijara': 'Cómpeta und die Sierra Almijara',
      'frigiliana-blauwe-deuren': 'Frigiliana',
      'nerja-baai-strand-kliffen': 'Eine Bucht unter den Klippen von Nerja',
      'canillas-de-albaida-balkons-bloemen': 'Canillas de Albaida',
      'canillas-de-albaida-pleintje-kerk': 'Der Dorfplatz von Canillas de Albaida',
      'competa-kerktoren-dorp': 'Cómpeta',
      'canillas-de-albaida-uitzicht-dal': 'Blick ins Tal bei Canillas de Albaida',
      'frigiliana-panorama-witte-dorp': 'Frigiliana am Berghang',
      'frigiliana-trappen-oude-wijk': 'Treppen in der Altstadt von Frigiliana',
      'nerja-strand-kustlijn': 'Die Küste bei Nerja',
      'nerja-uitzicht-bougainville': 'Bougainvillea in Nerja',
      'vocht-afbladderende-verf-muur': 'Aufsteigende Feuchtigkeit: abblätternde Farbe unten an der Wand',
      'lekkage-vlek-plafond-hoek': 'Ein Leck: Feuchtigkeitsfleck in der Deckenecke',
    },
  },
  sv: {
    welcomeTitle: 'Välkommen till Axarquía',
    welcome: [
      'Vita byar mot bergen, terrasser fulla av oliv-, mandel- och avokadoträd och en kust med små vikar under klipporna. Axarquía, öster om Málaga, är en av de vackraste platserna i Andalusien att bo på.',
      'Med omkring 300 soldagar om året, flygplatsen i Málaga ungefär en timmes bilresa bort och byar som Frigiliana, Cómpeta och Nerja är det lätt att förstå varför allt fler svenskar, nederländare, tyskar och britter köper hus här. Den här checklistan hjälper dig att göra det med gott samvete.',
    ],
    welcomeOther: 'Med omkring 300 soldagar om året, flygplatsen i Málaga ungefär en timmes bilresa bort och byar som Frigiliana, Cómpeta och Nerja är det lätt att förstå varför så många svenskar, nederländare, tyskar och britter har ett hus här. Ett hus i den här trakten kräver dock rätt angreppssätt, och det hjälper den här checklistan till med.',
    spot: 'Känner du igen det här?',
    spotIntro: 'Fukt och läckage är de vanligaste dolda bristerna i hus i Axarquía. Ett nytt lager färg döljer dem ofta under visningen.',
    captions: {
      'competa-panorama-sierra-almijara': 'Cómpeta och Sierra Almijara',
      'frigiliana-blauwe-deuren': 'Frigiliana',
      'nerja-baai-strand-kliffen': 'En vik under klipporna i Nerja',
      'canillas-de-albaida-balkons-bloemen': 'Canillas de Albaida',
      'canillas-de-albaida-pleintje-kerk': 'Torget i Canillas de Albaida',
      'competa-kerktoren-dorp': 'Cómpeta',
      'canillas-de-albaida-uitzicht-dal': 'Dalen nedanför Canillas de Albaida',
      'frigiliana-panorama-witte-dorp': 'Frigiliana på bergssidan',
      'frigiliana-trappen-oude-wijk': 'Trappor i gamla stan i Frigiliana',
      'nerja-strand-kustlijn': 'Kusten vid Nerja',
      'nerja-uitzicht-bougainville': 'Bougainvillea i Nerja',
      'vocht-afbladderende-verf-muur': 'Uppstigande fukt: flagnande färg nederst på väggen',
      'lekkage-vlek-plafond-hoek': 'Läckage: en fuktfläck i hörnet av taket',
    },
  },
};
const x = extra[lang] ?? extra.en;
// Welkomsttekst: de tweede alinea gaat bij de koopchecklist over kopen, bij de andere algemeen
const welcome = id === 'kopen' ? x.welcome : [x.welcome[0], x.welcomeOther];
// Bijschrift: eigen tekst, anders de plaatsnaam (plaatsfoto's) of het begin van de alt-tekst (onderwerpfoto's)
const places: [string, string][] = [['competa', 'Cómpeta'], ['frigiliana', 'Frigiliana'], ['nerja', 'Nerja'], ['canillas-de-albaida', 'Canillas de Albaida'], ['torre-del-mar', 'Torre del Mar']];
const cap = (n: string) => {
  if (x.captions[n]) return x.captions[n];
  const place = places.find(([p]) => n.startsWith(`${p}-`));
  if (place) return place[1];
  const alt = topicPhoto(n, lang)?.alt;
  return alt ? alt.split(':')[0] : '';
};
const { banners, strip, spot: defects } = ph;
const spot = c.spot ?? { title: x.spot, intro: x.spotIntro };
// Vaste blokken na de hoofdstukken, in de volgorde van hun nummer in de titel
const num = (t: string) => parseInt(t, 10) || 99;
const blocks = [
  c.questions && { kind: 'questions' as const, n: num(c.questions.title) },
  c.calc && { kind: 'calc' as const, n: num(c.calc.title) },
  c.after && { kind: 'after' as const, n: num(c.after.title) },
].filter((b): b is { kind: 'questions' | 'calc' | 'after'; n: number } => !!b).sort((a, b) => a.n - b.n);
---
<!doctype html>
<html lang={lang} data-noindex>
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="pdf-file" content={c.pdf} />
  <meta name="pdf-footer" content={`${c.title} · ${site.domain}`} />
  <title>{c.title}</title>
  <style is:inline>
    @page { size: A4; margin: 16mm 16mm 18mm; }
    @page :first { margin: 0; }
    :root { --terra: #b5532f; --terra-dark: #8f3f22; --sun: #e9a23b; --olive: #5f6b3c; --ink: #23201d; --muted: #625b54; --line: #e7dfd5; --sand: #f8f3ec; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Helvetica Neue', Arial, sans-serif; color: var(--ink); font-size: 10.5pt; line-height: 1.45; }
    h1, h2, h3 { font-family: Georgia, 'Palatino Linotype', serif; font-weight: 600; line-height: 1.2; }
    img { display: block; width: 100%; object-fit: cover; }

    /* Omslag: foto over de hele pagina */
    .cover { position: relative; width: 210mm; height: 297mm; overflow: hidden; break-after: page; color: #fff; }
    .cover img { position: absolute; inset: 0; height: 100%; }
    /* De donkere overloop zit in de foto zelf (omslag-competa.jpg): transparante lagen tonen sommige pdf-lezers verkeerd */
    .cover .inner { position: absolute; z-index: 2; left: 18mm; right: 18mm; bottom: 22mm; }
    .brand { display: flex; align-items: center; gap: 3mm; font-family: Georgia, serif; font-size: 16pt; position: absolute; z-index: 2; top: 14mm; left: 18mm; color: #fff; }
    .brand b { color: var(--sun); font-weight: 600; }
    .edition { display: inline-block; text-transform: uppercase; letter-spacing: 0.1em; font-size: 8.5pt; font-weight: 700; background: var(--terra); padding: 1.5mm 3.5mm; border-radius: 99px; margin: 0 0 5mm; }
    .cover h1 { font-size: 32pt; margin: 0 0 5mm; color: #fff; }
    .cover .sub { font-size: 13pt; margin: 0; max-width: 150mm; color: #f6efe7; }
    .cover .credit { position: absolute; z-index: 2; right: 18mm; bottom: 8mm; font-size: 7.5pt; color: #e8ddd2; margin: 0; }

    /* Welkom */
    .welcome h2 { font-size: 20pt; color: var(--terra-dark); margin: 0 0 3mm; }
    .welcome p { font-size: 11.5pt; margin: 0 0 3mm; }
    .strip { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 3mm; margin: 6mm 0 7mm; }
    .strip img { height: 62mm; border-radius: 3mm; }
    figure { margin: 0; }
    figcaption { font-size: 8pt; color: var(--muted); margin-top: 1.2mm; }
    .intro { background: var(--sand); border-left: 3px solid var(--terra); padding: 4mm 5mm; border-radius: 0 3mm 3mm 0; }
    .intro p { margin: 0 0 2mm; } .intro p:last-child { margin: 0; }

    h2 { font-size: 15pt; color: var(--terra-dark); margin: 7mm 0 2mm; break-after: avoid; }
    h3 { font-size: 11.5pt; margin: 4mm 0 2mm; break-after: avoid; }
    .banner { margin: 6mm 0 0; }
    .banner img { height: 42mm; border-radius: 3mm; }
    .banner + h2 { margin-top: 4mm; }
    .sintro { color: var(--muted); margin: 0 0 2.5mm; font-style: italic; }
    ul.box { list-style: none; padding: 0; margin: 0; }
    ul.box li { position: relative; padding: 1.1mm 0 1.1mm 7mm; border-bottom: 1px solid var(--line); break-inside: avoid; }
    ul.box li::before { content: ''; position: absolute; left: 0; top: 2.2mm; width: 3.4mm; height: 3.4mm; border: 1.3px solid var(--terra); border-radius: 1mm; }
    .spot { background: var(--sand); border-radius: 3mm; padding: 4mm; margin: 5mm 0 0; break-inside: avoid; }
    .spot h3 { margin: 0 0 1mm; color: var(--terra-dark); }
    .spot p { margin: 0 0 3mm; font-size: 9.5pt; color: var(--muted); }
    .spot .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 3mm; }
    .spot img { height: 40mm; border-radius: 2mm; }
    ol.q { padding-left: 5mm; margin: 0; } ol.q li { margin-bottom: 1.4mm; break-inside: avoid; }
    .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 7mm; }
    table { width: 100%; border-collapse: collapse; margin-top: 2mm; }
    th, td { text-align: left; padding: 2mm 2mm; border-bottom: 1px solid var(--line); vertical-align: bottom; }
    td.hint { color: var(--muted); font-size: 9pt; width: 38mm; }
    td.amount { width: 38mm; border-bottom: 1px solid var(--muted); }
    tr.total td { font-weight: 700; border-top: 2px solid var(--ink); border-bottom: none; }
    .note { color: var(--muted); font-size: 9pt; }
    .keep { break-inside: avoid; }
    .newpage { break-before: page; }

    /* Slot: foto met de oproep erover */
    .cta { position: relative; border-radius: 4mm; overflow: hidden; margin-top: 8mm; break-inside: avoid; color: #fff; min-height: 95mm; }
    .cta img { position: absolute; inset: 0; height: 100%; }
    .cta { background: #8f3f22; }
    .cta .inner { position: relative; z-index: 2; padding: 10mm 12mm; max-width: 125mm; }
    .cta h2 { color: #fff; margin-top: 0; font-size: 18pt; }
    .cta a.button { display: inline-block; background: #fff; color: var(--terra-dark); text-decoration: none; font-weight: 700; padding: 2.5mm 6mm; border-radius: 99px; margin-top: 2mm; }
    .cta .url { font-size: 9pt; color: #f6e6dc; margin: 3mm 0 0; }
    .disclaimer { margin-top: 4mm; }
  </style>
</head>
<body>
  <section class="cover">
    <img src={img(ph.cover)} alt="" />
    <div class="brand">
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path d="M4 15 16 5l12 10v12a1 1 0 0 1-1 1h-7v-8h-8v8H5a1 1 0 0 1-1-1z" fill="#fff"/><circle cx="24" cy="8" r="3" fill="#e9a23b"/></svg>
      <span>Axarquía<b>Home</b></span>
    </div>
    <div class="inner">
      <p class="edition">{c.edition}</p>
      <h1>{c.title}</h1>
      <p class="sub">{c.subtitle}</p>
    </div>
    <p class="credit">{cap(ph.coverPhoto)}</p>
  </section>

  <section class="welcome">
    <h2>{x.welcomeTitle}</h2>
    {welcome.map((p) => <p>{p}</p>)}
    <div class="strip">
      {strip.map((n) => <figure><img src={img(n)} alt="" /><figcaption>{cap(n)}</figcaption></figure>)}
    </div>
    <div class="intro">{c.intro.map((p) => <p>{p}</p>)}</div>
  </section>

  {c.sections.map((s, i) => (
    <div class:list={['section', 'keep', { newpage: i === 0 }]}>
      {/* Elk hoofdstuk past op één pagina en wordt niet opgeknipt */}
      {banners[i] && <figure class="banner"><img src={img(banners[i])} alt="" /><figcaption>{cap(banners[i])}</figcaption></figure>}
      <h2>{s.title}</h2>
      {s.intro && <p class="sintro">{s.intro}</p>}
      <ul class="box">{s.items.map((it) => <li>{it}</li>)}</ul>
      {i === ph.spotAt && (
        <div class="spot">
          <h3>{spot.title}</h3>
          <p>{spot.intro}</p>
          <div class="pair">{defects.map((n) => <figure><img src={img(n)} alt="" /><figcaption>{cap(n)}</figcaption></figure>)}</div>
        </div>
      )}
    </div>
  ))}

  {blocks.map((b) => b.kind === 'questions' && c.questions ? (
    <div class="section keep">
      <figure class="banner"><img src={img(ph.questions)} alt="" /><figcaption>{cap(ph.questions)}</figcaption></figure>
      <h2>{c.questions.title}</h2>
      <div class="cols">
        <div><h3>{c.questions.agentTitle}</h3><ol class="q">{c.questions.agent.map((q) => <li>{q}</li>)}</ol></div>
        <div><h3>{c.questions.lawyerTitle}</h3><ol class="q">{c.questions.lawyer.map((q) => <li>{q}</li>)}</ol></div>
      </div>
    </div>
  ) : b.kind === 'calc' && c.calc ? (
    <div class="section keep">
      <h2>{c.calc.title}</h2>
      <p class="sintro">{c.calc.intro}</p>
      <table>
        {c.calc.rows.map(([label, hint]) => <tr><td>{label}</td><td class="hint">{hint}</td><td class="amount">€</td></tr>)}
        <tr class="total"><td>{c.calc.total}</td><td></td><td>€</td></tr>
      </table>
      <p class="note">{c.calc.note}</p>
    </div>
  ) : b.kind === 'after' && c.after ? (
    <div class="section keep">
      <h2>{c.after.title}</h2>
      <ul class="box">{c.after.items.map((it) => <li>{it}</li>)}</ul>
    </div>
  ) : null)}

  <div class="keep">
  <div class="cta">
    <img src={img(ph.cta)} alt="" />
    <div class="inner">
      <h2>{c.cta.title}</h2>
      <p>{c.cta.text}</p>
      {c.cta.contactNote && <p>{c.cta.contactNote}</p>}
      <a class="button" href={requestUrl}>{c.cta.button}</a>
      <p class="url">{shortUrl} · {site.operator.email}</p>
    </div>
  </div>
  <p class="note disclaimer">{c.disclaimer}</p>
  </div>
</body>
</html>
