---
import '../styles/global.css';
import { site, isFilled } from '../data/site';
import { contactTeksten } from '../data/contactformulier';
import { ui, nav as navs, services as svcs, alternatesFor, langs, langNames, path as route, type Lang } from '../i18n';
import { hubAlternates, topicUi, type TopicLang } from '../data/topics';

interface Props {
  title: string;
  description: string;
  /** Pad van deze pagina, bijv. "/nl/renovatie/" */
  path: string;
  lang?: Lang;
  /** Vertalingen van deze pagina: { en: '/en/renovation/' } */
  alternates?: Partial<Record<Lang, string>>;
  jsonLd?: object[];
  noindex?: boolean;
  /** Deelafbeelding (1200 x 630), pad vanaf de root; standaard /og-image.png */
  ogImage?: string;
  ogImageAlt?: string;
}

const { title, description, path, lang = 'nl', alternates = {}, jsonLd = [], noindex = false, ogImageAlt } = Astro.props;
const canonical = new URL(path, site.url).href;
const allAlternates: Partial<Record<string, string>> = { ...alternatesFor(path), ...alternates, [lang]: path };
const t = ui[lang];
// Link naar de zelf-doen-gidsen in de footer, alleen in talen waarin die er zijn
const diyHub = (hubAlternates('diy') as Partial<Record<Lang, string>>)[lang];
const diyLabel = diyHub ? topicUi[lang as TopicLang].hub.diy : '';
const cookieText = {
  nl: { text: 'Mogen we cookies gebruiken om te zien hoe bezoekers deze site gebruiken? Zo kunnen we hem verbeteren.', yes: 'Accepteren', no: 'Weigeren', more: 'Meer in de privacyverklaring', settings: 'Cookie-instellingen' },
  en: { text: 'May we use cookies to see how visitors use this site? It helps us make it better.', yes: 'Accept', no: 'Decline', more: 'More in the privacy statement', settings: 'Cookie settings' },
  sv: { text: 'Får vi använda cookies för att se hur besökare använder webbplatsen? Det hjälper oss att göra den bättre.', yes: 'Godkänn', no: 'Avböj', more: 'Mer i integritetspolicyn', settings: 'Cookie-inställningar' },
  de: { text: 'Dürfen wir Cookies verwenden, um zu sehen, wie Besucher diese Website nutzen? So können wir sie verbessern.', yes: 'Akzeptieren', no: 'Ablehnen', more: 'Mehr in der Datenschutzerklärung', settings: 'Cookie-Einstellungen' },
}[lang];
const nav = navs[lang];
const others = langs
  .filter((l) => l !== lang)
  .map((l) => ({ l, href: allAlternates[l] ?? route(l, 'home') }));
const robots = !site.indexable || noindex ? 'noindex, nofollow' : 'index, follow';
// Google toont ongeveer 60 tekens. De merknaam alleen toevoegen als die er nog bij past.
const isHome = langs.some((l) => path === `/${l}/`);
const withBrand = `${title} | ${site.brand}`;
const fullTitle = isHome || withBrand.length > 60 ? title : withBrand;
const ogLocale = { nl: 'nl_NL', en: 'en_GB', de: 'de_DE', sv: 'sv_SE' }[lang];
const ogImage = new URL(Astro.props.ogImage ?? '/og-image.png', site.url).href;

const c = site.company;
const organization: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${site.url}/#bedrijf`,
  name: site.brand,
  url: site.url,
  areaServed: site.villages.map((v) => ({ '@type': 'Place', name: `${v}, Málaga, España` })),
  knowsLanguage: ['nl', 'en', 'de', 'es'],
  logo: `${site.url}/favicon.svg`,
  image: `${site.url}/og-image.png`,
};
if (isFilled(c.phone)) organization.telephone = c.phone;
if (isFilled(c.email)) organization.email = c.email;
if (isFilled(c.street) && isFilled(c.town)) {
  organization.address = {
    '@type': 'PostalAddress',
    streetAddress: c.street,
    postalCode: isFilled(c.postalCode) ? c.postalCode : undefined,
    addressLocality: c.town,
    addressRegion: 'Málaga',
    addressCountry: 'ES',
  };
}
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.brand,
  url: `${site.url}/${lang}/`,
  inLanguage: lang,
  publisher: { '@id': `${site.url}/#bedrijf` },
};
const schemas = isHome ? [organization, website, ...jsonLd] : [organization, ...jsonLd];
const current = Astro.url.pathname;
// Talen waarin het team niet zelf spreekt: contact gaat in het Engels of Nederlands
const englishContact: Partial<Record<Lang, string>> = { sv: 'Kontakten sker på engelska eller nederländska.', de: 'Der Kontakt läuft auf Englisch oder Niederländisch.' };
---
<!doctype html>
<html lang={lang} data-noindex={noindex ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {Object.entries(allAlternates).map(([l, p]) => (
      <link rel="alternate" hreflang={l} href={new URL(p!, site.url).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(allAlternates.en ?? allAlternates.nl ?? path, site.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#b5532f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? site.brand} />
    <meta name="twitter:card" content="summary_large_image" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {(site.clarityId || site.gaId) && (
      <script is:inline define:vars={{ id: site.clarityId, ga: site.gaId }}>
        window.axhLoadClarity = function () {
          if (ga && !window.gtag) {
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { window.dataLayer.push(arguments); };
            window.gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'granted' });
            window.gtag('js', new Date());
            window.gtag('config', ga, { anonymize_ip: true });
            var g = document.createElement('script'); g.async = true; g.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga;
            document.head.appendChild(g);
          }
          if (!id || window.clarity) return;
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', id);
          window.clarity('consent');
        };
        try { if (localStorage.getItem('axh-consent') === 'yes') window.axhLoadClarity(); } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#inhoud">{t.skip}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href={route(lang, 'home')} class="logo" aria-label={`${site.brand}, ${t.toHome}`}>
          <svg viewBox="0 0 64 64" width="36" height="36" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#1f4e5f"/><circle cx="50" cy="13" r="4.5" fill="#e9a23b"/><path d="M8 28 32 10l24 18" fill="none" stroke="#ffffff" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/><g transform="translate(32 41) scale(.82) translate(-32 -39)"><g transform="rotate(40 32 39)"><rect x="30" y="31" width="4" height="19" rx="2" fill="#e9a23b"/><circle cx="32" cy="29" r="6" fill="#e9a23b"/><rect x="29.6" y="21" width="4.8" height="7.5" fill="#1f4e5f"/></g><g transform="rotate(-40 32 39)"><rect x="30" y="30" width="4" height="20" rx="2" fill="#ffffff"/><rect x="23" y="25" width="18" height="7" rx="1.5" fill="#ffffff"/></g></g><path d="M12 56q5-3.5 10 0t10 0 10 0 10 0" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" opacity=".75"/></svg>
          <span>Axarquía<b>Home</b></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="hoofdmenu" aria-label={t.menuOpen}>
          <span></span><span></span><span></span>
        </button>
        <nav id="hoofdmenu" class="menu" aria-label={t.mainMenu}>
          <ul class="nav-list">
            {nav.map((n) => n.children ? (
              <li class="has-sub">
                <button type="button" class="sub-toggle" aria-expanded="false">{n.label}</button>
                <ul class="sub">
                  {n.children.map((c) => (
                    <li><a href={c.href} aria-current={current === c.href ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              </li>
            ) : (
              <li><a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
          <ul class="lang-switch" aria-label={t.langLabel}>
            {others.map((o) => (
              <li><a href={o.href} hreflang={o.l} lang={o.l} title={`${ui[o.l].readIn} ${langNames[o.l]}`}>{o.l.toUpperCase()}</a></li>
            ))}
          </ul>
          <a class="btn btn-small" href={route(lang, 'request')}>{t.cta}</a>
        </nav>
        <script>
          const b = document.querySelector('.menu-toggle');
          const m = document.getElementById('hoofdmenu');
          b?.addEventListener('click', () => {
            const open = m?.classList.toggle('open');
            b.setAttribute('aria-expanded', String(!!open));
          });
          document.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((t) => {
            t.addEventListener('click', () => {
              const open = t.getAttribute('aria-expanded') !== 'true';
              t.setAttribute('aria-expanded', String(open));
            });
            t.parentElement?.addEventListener('focusout', (e) => {
              if (!t.parentElement!.contains((e as FocusEvent).relatedTarget as Node)) t.setAttribute('aria-expanded', 'false');
            });
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') document.querySelectorAll('.sub-toggle').forEach((t) => t.setAttribute('aria-expanded', 'false'));
          });
        </script>
      </div>
    </header>

    <main id="inhoud">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand">Axarquía<b>Home</b></p>
          <p>{t.tagline}</p>
          <p class="footer-langs">{others.map((o) => <a href={o.href} hreflang={o.l} lang={o.l}>{langNames[o.l]}</a>)}</p>
        </div>
        <div>
          <p class="footer-title">{t.fServices}</p>
          <ul>
            {svcs[lang].map((s) => <li><a href={s.href}>{s.title}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="footer-title">{t.fContact}</p>
          <ul>
            <li><a href={route(lang, 'request')}>{t.fRequest}</a></li>
            <li><a href={route(lang, 'contact')}>{contactTeksten[lang].footer}</a></li>
            {isFilled(c.whatsapp) && <li><a href={`https://wa.me/${c.whatsapp}`}>WhatsApp</a></li>}
            {isFilled(c.phone) && <li><a href={`tel:${c.phone.replace(/\s/g, '')}`}>{c.phone}</a></li>}
            <li><a href={`mailto:${site.operator.email}`}>{site.operator.email}</a></li>
          </ul>
          {englishContact[lang] && <p class="footer-note">{englishContact[lang]}</p>}
        </div>
        <div>
          <p class="footer-title">{t.fAbout}</p>
          <ul>
            <li><a href={route(lang, 'guides')}>{t.fGuides}</a></li>
            {diyHub && <li><a href={diyHub}>{diyLabel}</a></li>}
            <li><a href={route(lang, 'about')}>{t.fAboutUs}</a></li>
            <li><a href={route(lang, 'projects')}>{t.fProjects}</a></li>
            <li><a href={route(lang, 'privacy')}>{t.fPrivacy}</a></li>
            {(site.clarityId || site.gaId) && <li><button type="button" class="link-btn" data-cookie-open>{cookieText.settings}</button></li>}
          </ul>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p>© {new Date().getFullYear()} {site.brand}. {t.builtBy(isFilled(c.name) ? c.name : t.builtByDefault)}</p>
      </div>
    </footer>
    {(site.clarityId || site.gaId) && (
      <div class="cookie-bar" role="region" aria-label={cookieText.settings} hidden>
        <div class="wrap cookie-inner">
          <p>{cookieText.text} <a href={route(lang, 'privacy')}>{cookieText.more}</a></p>
          <div class="cookie-actions">
            <button type="button" class="btn btn-ghost" data-cookie="no">{cookieText.no}</button>
            <button type="button" class="btn" data-cookie="yes">{cookieText.yes}</button>
          </div>
        </div>
      </div>
      <script is:inline>
        (function () {
          var bar = document.querySelector('.cookie-bar');
          var get = function () { try { return localStorage.getItem('axh-consent'); } catch (e) { return null; } };
          var set = function (v) { try { localStorage.setItem('axh-consent', v); } catch (e) {} };
          if (!get()) bar.hidden = false;
          bar.addEventListener('click', function (e) {
            var b = e.target.closest('[data-cookie]'); if (!b) return;
            var v = b.getAttribute('data-cookie'), was = get();
            set(v); bar.hidden = true;
            if (v === 'yes') window.axhLoadClarity && window.axhLoadClarity();
            else if (was === 'yes') {
              if (window.clarity) window.clarity('consent', false);
              if (window.gtag) window.gtag('consent', 'update', { analytics_storage: 'denied' });
              document.cookie.split(';').forEach(function (c) {
                var n = c.split('=')[0].trim();
                if (/^_cl|^CLID$|^MUID$|^_ga/.test(n)) document.cookie = n + '=; Max-Age=0; path=/; domain=.' + location.hostname.replace(/^www\./, '');
                document.cookie = n + '=; Max-Age=0; path=/';
              });
              location.reload();
            }
          });
          document.addEventListener('click', function (e) {
            if (e.target.closest('[data-cookie-open]')) { bar.hidden = false; bar.querySelector('[data-cookie="yes"]').focus(); }
          });
        })();
      </script>
    )}
  </body>
</html>
