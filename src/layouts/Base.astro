---
import '../styles/global.css';
import { site, isFilled } from '../data/site';
import { ui, nav as navs, services as svcs, alternatesFor, langs, langNames, path as route, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Pad van deze pagina, bijv. "/nl/renovatie/" */
  path: string;
  lang?: Lang;
  /** Vertalingen van deze pagina: { en: '/en/renovation/' } */
  alternates?: Partial<Record<'nl' | 'en' | 'de', string>>;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description, path, lang = 'nl', alternates = {}, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const allAlternates: Partial<Record<string, string>> = { ...alternatesFor(path), ...alternates, [lang]: path };
const t = ui[lang];
const nav = navs[lang];
const others = langs
  .filter((l) => l !== lang)
  .map((l) => ({ l, href: allAlternates[l] ?? route(l, 'home') }));
const robots = !site.launchReady || noindex ? 'noindex, nofollow' : 'index, follow';
const fullTitle = langs.some((l) => path === `/${l}/`) ? title : `${title} | ${site.brand}`;

const c = site.company;
const organization: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${site.url}/#bedrijf`,
  name: site.brand,
  url: site.url,
  areaServed: site.villages.map((v) => ({ '@type': 'Place', name: `${v}, Málaga, España` })),
  knowsLanguage: ['nl', 'en', 'de', 'es'],
};
if (isFilled(c.phone)) organization.telephone = c.phone;
if (isFilled(c.email)) organization.email = c.email;
if (isFilled(c.street) && isFilled(c.town)) {
  organization.address = {
    '@type': 'PostalAddress',
    streetAddress: c.street,
    postalCode: isFilled(c.postalCode) ? c.postalCode : undefined,
    addressLocality: c.town,
    addressRegion: 'Málaga',
    addressCountry: 'ES',
  };
}
const schemas = [organization, ...jsonLd];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {Object.entries(allAlternates).map(([l, p]) => (
      <link rel="alternate" hreflang={l} href={new URL(p!, site.url).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(allAlternates.en ?? allAlternates.nl ?? path, site.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#b5532f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : lang === 'en' ? 'en_GB' : 'de_DE'} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {site.clarityId && (
      <script is:inline define:vars={{ id: site.clarityId }}>
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', id);
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#inhoud">{t.skip}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href={route(lang, 'home')} class="logo" aria-label={`${site.brand}, ${t.toHome}`}>
          <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path d="M4 15 16 5l12 10v12a1 1 0 0 1-1 1h-7v-8h-8v8H5a1 1 0 0 1-1-1z" fill="currentColor"/><circle cx="24" cy="8" r="3" fill="#e9a23b"/></svg>
          <span>Axarquía<b>Home</b></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="hoofdmenu" aria-label={t.menuOpen}>
          <span></span><span></span><span></span>
        </button>
        <nav id="hoofdmenu" class="menu" aria-label={t.mainMenu}>
          <ul class="nav-list">
            {nav.map((n) => n.children ? (
              <li class="has-sub">
                <button type="button" class="sub-toggle" aria-expanded="false">{n.label}</button>
                <ul class="sub">
                  {n.children.map((c) => (
                    <li><a href={c.href} aria-current={current === c.href ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              </li>
            ) : (
              <li><a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
          <ul class="lang-switch" aria-label={t.langLabel}>
            {others.map((o) => (
              <li><a href={o.href} hreflang={o.l} lang={o.l} title={`${ui[o.l].readIn} ${langNames[o.l]}`}>{o.l.toUpperCase()}</a></li>
            ))}
          </ul>
          <a class="btn btn-small" href={route(lang, 'request')}>{t.cta}</a>
        </nav>
        <script>
          const b = document.querySelector('.menu-toggle');
          const m = document.getElementById('hoofdmenu');
          b?.addEventListener('click', () => {
            const open = m?.classList.toggle('open');
            b.setAttribute('aria-expanded', String(!!open));
          });
          document.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((t) => {
            t.addEventListener('click', () => {
              const open = t.getAttribute('aria-expanded') !== 'true';
              t.setAttribute('aria-expanded', String(open));
            });
            t.parentElement?.addEventListener('focusout', (e) => {
              if (!t.parentElement!.contains((e as FocusEvent).relatedTarget as Node)) t.setAttribute('aria-expanded', 'false');
            });
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') document.querySelectorAll('.sub-toggle').forEach((t) => t.setAttribute('aria-expanded', 'false'));
          });
        </script>
      </div>
    </header>

    <main id="inhoud">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand">Axarquía<b>Home</b></p>
          <p>{t.tagline}</p>
          <p class="footer-langs">{others.map((o) => <a href={o.href} hreflang={o.l} lang={o.l}>{langNames[o.l]}</a>)}</p>
        </div>
        <div>
          <p class="footer-title">{t.fServices}</p>
          <ul>
            {svcs[lang].map((s) => <li><a href={s.href}>{s.title}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="footer-title">{t.fContact}</p>
          <ul>
            <li><a href={route(lang, 'request')}>{t.fRequest}</a></li>
            {isFilled(c.whatsapp) && <li><a href={`https://wa.me/${c.whatsapp}`}>WhatsApp</a></li>}
            {isFilled(c.phone) && <li><a href={`tel:${c.phone.replace(/\s/g, '')}`}>{c.phone}</a></li>}
            <li><a href={`mailto:${site.operator.email}`}>{site.operator.email}</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-title">{t.fAbout}</p>
          <ul>
            <li><a href={route(lang, 'guides')}>{t.fGuides}</a></li>
            <li><a href={route(lang, 'about')}>{t.fAboutUs}</a></li>
            <li><a href={route(lang, 'projects')}>{t.fProjects}</a></li>
            <li><a href={route(lang, 'privacy')}>{t.fPrivacy}</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p>© {new Date().getFullYear()} {site.brand}. {t.builtBy(isFilled(c.name) ? c.name : t.builtByDefault)}</p>
      </div>
    </footer>
  </body>
</html>
